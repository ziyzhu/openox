{
  "private": true,
  "author": "Ziyuan Zhu",
  "license": "Apache-2.0",
  "workspaces": ["apps/cli", "packages/protocol", "packages/services", "packages/agent"],
  "scripts": {
    "ci": "./.agents/skills/test/scripts/ci.sh",
    "ci:ios": "bun .agents/skills/test/apps/ios/smoke.ts",
    "test:e2e": "bun test ./.agents/skills/test",
    "test:logs": "bun .agents/skills/test/apps/cli/logs.ts",
    "test:host-macos": "bun .agents/skills/test/apps/macos/host.ts",
    "generate:ios": "xcodegen generate --spec apps/ios/project.yml",
    "generate:macos": "xcodegen generate --spec apps/macos/project.yml",
    "build:macos": "bun run generate:macos && xcodebuild -project apps/macos/OxHost.xcodeproj -scheme host -configuration Debug -destination 'platform=macOS' build",
    "evals": "bun .agents/skills/evals/scripts/runner.ts",
    "build:services": "bun .agents/skills/build/scripts/ios-services-build.ts",
    "test:demo": "bun .agents/skills/test/apps/ios/demo-preview.ts",
    "build:agent": "bun packages/agent/build.ts",
    "test:agent": "bun test packages/agent/test",
    "test:agent-ui-ios": "bun .agents/skills/test/apps/ios/durable-conversation.ts",
    "sim:bootstrap": "bun .agents/skills/setup/scripts/bootstrap.ts",
    "sim:launch": "bun .agents/skills/setup/scripts/template.ts",
    "sim:website-export": "bun .agents/skills/setup/scripts/website-export.ts",
    "update:llms": "bun .agents/skills/build/scripts/provider-models.ts",
    "build:provider-schema": "bun .agents/skills/build/scripts/provider-definitions.ts",
    "build:host-schema": "bun .agents/skills/build/scripts/host-rpc-contract.ts --write",
    "build:repository-schema": "bun .agents/skills/build/scripts/repository-contract.ts --write",
    "typecheck": "bun .agents/skills/build/scripts/typecheck.ts"
  },
  "dependencies": {
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
