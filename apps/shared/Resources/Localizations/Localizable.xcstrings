      }
    },
    "Lets the agent add events to your calendar — a booking, a reservation, an appointment. It never reads your calendar." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让代理把活动添加到你的日历——预订、预约、约会。它从不读取你的日历。"
          }
        }
      }
    },
    "Lets the agent add to-dos to your Reminders — renew, follow up, cancel a trial. It never reads your reminders." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让代理把待办添加到你的提醒事项——续订、跟进、取消试用。它从不读取你的提醒事项。"
          }
        }
      }
    },
    "Lets the agent look up your contacts by name to answer questions or fill in an email or number for another task. It reads contact details into the conversation." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让代理按姓名查找你的通讯录，以回答问题或为其他任务填入邮箱或号码。它会把联系人详情读入对话。"
          }
        }
      }
    },
    "Lets the agent open a text message pre-filled with a contact and body. It resolves the name to a number on-device, never sees your conversations, and you tap Send yourself." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让代理打开一条已填好收件人和内容的短信。它在设备本地把联系人姓名解析成号码,从不查看你的对话,且由你自己点击发送。"
          }
        }
      }
    },
    "Lets the agent read activity, sleep, workouts, vitals, and body summaries allowed by iOS. Health data is available only in Profiles stored on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
