{
  "domain": "www.facebook.com",
  "name": "Facebook",
  "description": "A social network for communities and local commerce. Read group posts, friend suggestions, and Marketplace listings; sign-in required.",
  "baseUrl": "https://www.facebook.com/robots.txt",
  "$defs": {
    "post": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "imageUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "author",
        "message",
        "createdAt",
        "url",
        "imageUrl"
      ],
      "additionalProperties": false
    },
    "postPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/post"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "person": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mutualContext": {
          "type": "string"
        },
        "profilePictureUrl": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "mutualContext",
        "profilePictureUrl",
        "url"
      ],
      "additionalProperties": false
    },
    "personPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/person"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "listing": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "price": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "sellerName": {
          "type": "string"
        },
        "createdAt": {
          "type": "integer"
        },
        "imageUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "price",
        "location",
        "sellerName",
        "createdAt",
        "imageUrl",
        "url"
      ],
      "additionalProperties": false
    },
    "listingPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/listing"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    }
  },
  "actions": [
    {
      "id": "login",
      "label": "Log in",
      "description": "Prepare website login for the user. Completion does not verify authentication.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "null"
      },
      "requireApproval": false,
      "requireAuth": false,
      "baseUrl": "https://www.facebook.com/"
    },
    {
      "id": "listSessions",
      "label": "List signed-in accounts",
      "description": "Discover currently authenticated accounts. Errors do not establish absence.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "label",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "requireApproval": false,
      "requireAuth": false,
      "baseUrl": "https://www.facebook.com/"
    },
    {
      "id": "listGroupPosts",
      "label": "List group posts",
      "description": "Lists posts from a Facebook group you can view.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "groupId": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "The numeric group ID from the group's Facebook URL."
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "description": "The continuation value returned by the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5,
            "description": "The maximum number of posts to request."
          }
        },
        "required": [
          "groupId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/postPage"
      },
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://www.facebook.com/"
    },
    {
      "id": "listFriendSuggestions",
      "label": "List friend suggestions",
      "description": "Lists people Facebook currently suggests you may know.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "description": "The continuation value returned by the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20,
            "description": "The maximum number of suggestions to request."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/personPage"
      },
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://www.facebook.com/"
    },
    {
      "id": "listMarketplace",
      "label": "Browse Marketplace",
      "description": "Lists Facebook Marketplace items near a chosen location.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "The center latitude for nearby results."
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "The center longitude for nearby results."
          },
          "radiusKm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 65,
            "description": "The search radius in kilometers."
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "description": "The continuation value returned by the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 12,
            "description": "The maximum number of listings to request."
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/listingPage"
      },
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://www.facebook.com/"
    },
    {
      "id": "searchMarketplace",
      "label": "Search Marketplace",
      "description": "Searches Facebook Marketplace near a chosen location.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Words describing the item to find."
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "The center latitude for nearby results."
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "The center longitude for nearby results."
          },
          "radiusKm": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 65,
            "description": "The search radius in kilometers."
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "description": "The continuation value returned by the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 24,
            "description": "The maximum number of listings to request."
          }
        },
        "required": [
          "query",
          "latitude",
          "longitude"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/listingPage"
      },
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://www.facebook.com/"
    },
    {
      "id": "getMessageAccess",
      "label": "Check Messenger access",
      "description": "Open Messenger and report whether encrypted chat history needs restoration.",
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true,
      "baseUrl": "https://www.facebook.com/",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "requiresRestore": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "preview": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "preview"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "requiresRestore",
          "status",
          "items"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "listFriendsFeed",
      "label": "Read friends feed",
      "description": "Read a bounded snapshot of posts rendered in Facebook’s friends-only feed; timestamps and completeness may be unavailable.",
      "baseUrl": "https://www.facebook.com/?filter=friends&sk=h_chr",
      "blocking": true,
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "author": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "timeLabel": {
                  "type": "string"
                },
                "imageDescriptions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "author",
                "message",
                "url",
                "timeLabel",
                "imageDescriptions"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          },
          "coverage": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "coverage"
        ],
        "additionalProperties": false
      }
    }
  ],
  "faviconUrl": "https://openox.ai/assets/services/www.facebook.com/favicon.png"
}