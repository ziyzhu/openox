{
  "domain": "deepseek.com",
  "faviconUrl": "https://openox.ai/assets/services/deepseek.com/favicon.png",
  "name": "DeepSeek Research & News",
  "description": "Read public DeepSeek news and research links through normal rendered pages, without direct HTML fetch requests. Does not access DeepSeek chat accounts.",
  "baseUrl": "https://www.deepseek.com/en/news/",
  "actions": [
    {
      "id": "listPosts",
      "label": "List DeepSeek news",
      "description": "Expand the native View All news listing. Returns partial coverage if the bounded result limit is reached.",
      "blocking": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "excerpt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "title",
                "url",
                "date",
                "excerpt"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverage": {
            "type": "string",
            "enum": [
              "complete",
              "partial"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor",
          "coverage"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "listResearch",
      "label": "List DeepSeek research links",
      "description": "Read the visible research index on the news page. Links may point to arXiv or GitHub; this bounded snapshot is explicitly partial.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "excerpt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "title",
                "url",
                "date",
                "excerpt"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverage": {
            "type": "string",
            "enum": [
              "complete",
              "partial"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor",
          "coverage"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "getPost",
      "label": "Read DeepSeek news article",
      "description": "Read a public English DeepSeek news article by a URL returned by listPosts, following its normal in-page link. No direct HTML fetch or account routing is used.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "url",
          "date",
          "text",
          "links"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false,
      "blocking": true
    }
  ]
}
