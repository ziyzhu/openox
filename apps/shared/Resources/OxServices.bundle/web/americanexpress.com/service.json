            "enum": [
              "AIRPORT_CODE",
              "CITY_CODE"
            ]
          },
          "destinationType": {
            "type": "string",
            "enum": [
              "AIRPORT_CODE",
              "CITY_CODE"
            ]
          },
          "departureDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "returnDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "adults": {
            "type": "string",
            "pattern": "^[1-9]$",
            "description": "Adult traveler count as a URL-safe digit."
          },
          "cabinClass": {
            "type": "string",
            "enum": [
              "ECONOMY",
              "PREMIUM_ECONOMY",
              "BUSINESS",
              "FIRST"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "airline": {
            "type": "string",
            "description": "Optional case-insensitive airline filter over loaded results."
          }
