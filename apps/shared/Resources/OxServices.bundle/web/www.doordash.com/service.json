{
  "id": "searchStores",
  "label": "Find restaurant stores",
  "description": "Filters the public restaurants-near-me directory by store name. Location context must be website-selected; no address is applied and results do not establish the user’s location. This is a bounded directory snapshot, not marketplace-wide search.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "maxLength": 150
      },
      "locationContext": {
        "type": "string",
        "enum": [
          "website-selected"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 20
      }
    },
    "required": [
      "query",
      "locationContext"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "storeId": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          },
          "required": [
            "storeId",
            "name",
            "url",
            "summary"
          ],
          "additionalProperties": false
        }
      },
      "locationContext": {
        "type": "string"
      },
      "locationApplied": {
        "type": "boolean"
      },
      "sourceUrl": {
        "type": "string"
      },
      "complete": {
        "type": "boolean"
      },
      "nextCursor": {
        "type": "null"
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "items",
      "locationContext",
      "locationApplied",
      "sourceUrl",
      "complete",
      "nextCursor",
      "limitations"
    ],
    "additionalProperties": false
  },
  "requireApproval": false,
  "requireAuth": false
},
