{
  "domain": "instagram.com",
  "name": "Instagram",
  "description": "Instagram profiles, posts, Explore, recent inbox previews, and account switching. Sign-in required.",
  "baseUrl": "https://www.instagram.com/",
  "$defs": {
    "media": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "taken_at": {
          "type": "integer"
        },
        "media_type": {
          "type": "integer"
        },
        "product_type": {
          "type": "string"
        },
        "is_video": {
          "type": "boolean"
        },
        "like_count": {
          "type": "integer"
        },
        "comment_count": {
          "type": "integer"
        },
        "view_count": {
          "type": "integer"
        },
        "image_url": {
          "type": "string"
        },
        "video_url": {
          "type": "string"
        },
        "accessibility_caption": {
          "type": "string"
        },
        "owner": {
          "type": "object",
          "properties": {
            "pk": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "full_name": {
              "type": "string"
            },
            "is_verified": {
              "type": "boolean"
            }
          },
          "required": [
            "pk",
            "username",
            "full_name",
            "is_verified"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "code",
        "url",
        "caption",
        "taken_at",
        "media_type",
        "product_type",
        "is_video",
        "like_count",
        "comment_count",
        "view_count",
        "image_url",
        "video_url",
        "accessibility_caption",
        "owner"
      ],
      "additionalProperties": false
    },
    "user": {
      "type": "object",
      "properties": {
        "pk": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "full_name": {
          "type": "string"
        },
        "is_verified": {
          "type": "boolean"
        },
        "profile_pic_url": {
          "type": "string"
        }
      },
      "required": [
        "pk",
        "username",
        "full_name",
        "is_verified",
        "profile_pic_url"
      ],
      "additionalProperties": false
    },
    "mediaPage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/media"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    }
  },
  "actions": [
    {
      "id": "login",
      "label": "Log in",
      "description": "Use a saved Instagram account on the password form, preserving the existing account-switch preparation without signing out; leave security checks to the user.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "null"
      },
      "requireApproval": false,
      "requireAuth": false,
      "baseUrl": "https://www.instagram.com/accounts/login/",
      "blocking": true
    },
    {
      "id": "listSessions",
      "baseUrl": "https://www.instagram.com/robots.txt",
      "label": "List signed-in accounts",
      "description": "Discover currently authenticated accounts. Errors do not establish absence.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "label",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getProfile",
      "label": "Get user profile",
      "description": "Fetch an Instagram user's profile (bio, follower/following counts, post count, etc.) by username.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_.]{1,30}$"
          }
        },
        "required": [
          "username"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "pk": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "biography": {
            "type": "string"
          },
          "is_private": {
            "type": "boolean"
          },
          "is_verified": {
            "type": "boolean"
          },
          "is_business": {
            "type": "boolean"
          },
          "follower_count": {
            "type": "integer"
          },
          "following_count": {
            "type": "integer"
          },
          "media_count": {
            "type": "integer"
          },
          "category": {
            "type": "string"
          },
          "external_url": {
            "type": "string"
          },
          "profile_pic_url": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "pk",
          "username",
          "full_name",
          "biography",
          "is_private",
          "is_verified",
          "is_business",
          "follower_count",
          "following_count",
          "media_count",
          "category",
          "external_url",
          "profile_pic_url",
          "url"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {
        "username": "instagram"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "listUserPosts",
      "label": "List a user's posts",
      "description": "Lists a user's posts, newest first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_.]{1,30}$"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "username"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/mediaPage"
      },
      "defaultArgs": {
        "username": "instagram"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "listUserReels",
      "label": "List a user's reels",
      "description": "Lists a user's reels and clips, newest first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_.]{1,30}$"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "username"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/mediaPage"
      },
      "defaultArgs": {
        "username": "instagram"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "getPost",
      "label": "Get a post",
      "description": "Fetch a single post/reel by its numeric media id, shortcode, or instagram.com/p/<code>/ URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/media"
      },
      "defaultArgs": {
        "id": "https://www.instagram.com/p/DZIeQ8QsJ5x/"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "listPostComments",
      "label": "List a post's comments",
      "description": "Lists comments on a post selected by its link, short code, or media ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "username": {
                  "type": "string"
                },
                "like_count": {
                  "type": "integer"
                },
                "reply_count": {
                  "type": "integer"
                },
                "created_at": {
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "text",
                "username",
                "like_count",
                "reply_count",
                "created_at"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "searchUsers",
      "label": "Search users",
      "description": "Search Instagram users by name or username (top results).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/user"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {
        "query": "amazon"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "listExplore",
      "label": "List explore grid",
      "description": "Lists photos and videos from Instagram Explore.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/mediaPage"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "logout",
      "label": "Sign out",
      "description": "Sign out the selected current Instagram account on this device.",
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "requested": {
            "type": "boolean"
          }
        },
        "required": [
          "requested"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "listInbox",
      "label": "Read recent inbox previews",
      "description": "Read the currently rendered recent conversation previews; does not open threads or mark them read. Requests and older unloaded conversations are not included.",
      "baseUrl": "https://www.instagram.com/direct/inbox/",
      "blocking": true,
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "preview": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "preview"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          },
          "coverage": {
            "type": "string"
          }
        },
        "required": [
          "account",
          "items",
          "nextCursor",
          "coverage"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "switchAccount",
      "label": "Switch Instagram account",
      "description": "Switch from the selected current account to a named account already available in Instagram’s account picker.",
      "baseUrl": "https://www.instagram.com/direct/inbox/",
      "blocking": true,
      "requireAuth": true,
      "requireApproval": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_.]{1,30}$"
          }
        },
        "required": [
          "username"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "requested": {
            "type": "boolean"
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "requested",
          "username"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "listStoryTray",
      "label": "List current story tray",
      "description": "List loaded followed-account story tray entries without opening stories. Ranked tray is not a complete friends list.",
      "baseUrl": "https://www.instagram.com/",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "latest": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "seen": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "username",
                "id",
                "latest",
                "seen"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "viewStory",
      "label": "View an account’s story",
      "description": "Open the first story from a loaded home tray account. May register a story view. Does not react or send messages. Returns currently rendered story text and media only.",
      "baseUrl": "https://www.instagram.com/",
      "blocking": true,
      "requireAuth": true,
      "requireApproval": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.]{1,30}$"
          }
        },
        "required": [
          "username"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "alt"
              ],
              "additionalProperties": false
            }
          },
          "video": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "text",
          "images",
          "video"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "getStoryPage",
      "label": "Read current story page",
      "description": "Inspect rendered story page without clicking or advancing.",
      "baseUrl": "https://www.instagram.com/",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              },
              "required": [
                "url",
                "alt",
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "url",
          "text",
          "controls",
          "images"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "confirmStoryView",
      "label": "Confirm story view",
      "description": "Confirm Instagram’s View story prompt and read the rendered story. Registers a view; no messages or reactions.",
      "baseUrl": "https://www.instagram.com/",
      "requireAuth": true,
      "requireApproval": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                }
              },
              "required": [
                "url",
                "alt",
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "url",
          "text",
          "controls",
          "images"
        ],
        "additionalProperties": false
      }
    }
  ],
  "locales": {
    "zh-Hans": {
      "name": "Instagram",
      "description": "Instagram 用户资料、帖子、探索页、最近收件箱预览和账号切换。需要登录。",
      "actions": {
        "getProfile": {
          "label": "获取用户资料",
          "description": "按用户名获取 Instagram 用户资料（简介、粉丝/关注数、帖子数等）。"
        },
        "listUserPosts": {
          "label": "用户帖子列表",
          "description": "列出用户的帖子，最新内容排在前面。"
        },
        "listUserReels": {
          "label": "用户 Reels 列表",
          "description": "列出用户的 Reels 和短片，最新内容排在前面。"
        },
        "getPost": {
          "label": "获取帖子",
          "description": "按数字媒体 id、shortcode 或 instagram.com/p/<code>/ 网址获取单条帖子/Reel。"
        },
        "listPostComments": {
          "label": "帖子评论列表",
          "description": "按帖子链接、短码或媒体 ID 列出评论。"
        },
        "searchUsers": {
          "label": "搜索用户",
          "description": "按姓名或用户名搜索 Instagram 用户（返回最佳匹配）。"
        },
        "listExplore": {
          "label": "探索页列表",
          "description": "列出 Instagram 探索页中的照片和视频。"
        },
        "login": {
          "label": "登录",
          "description": "使用已保存的 Instagram 账号在密码表单中登录；保留原有账号切换准备流程而不退出登录，安全验证由用户完成。"
        },
        "listSessions": {
          "label": "列出已登录账号",
          "description": "发现当前已通过身份验证的账号。错误不代表没有账号。"
        },
        "logout": {
          "label": "退出登录",
          "description": "退出此设备上所选的当前 Instagram 账号。"
        },
        "listInbox": {
          "label": "读取最近收件箱预览",
          "description": "读取当前已加载的会话预览，不打开会话或标为已读；不包含消息请求及未加载的旧会话。"
        },
        "switchAccount": {
          "label": "切换 Instagram 账号",
          "description": "从所选当前账号切换到 Instagram 账号选择器中已有的指定账号。"
        }
      }
    }
  },
  "faviconUrl": "https://openox.ai/assets/services/instagram.com/favicon.png"
}