{
  "domain": "coinbase.com",
  "name": "Coinbase",
  "description": "Read-only Coinbase account connection. No trading or fund transfers.",
  "baseUrl": "https://www.coinbase.com/",
  "faviconUrl": "https://openox.ai/assets/services/coinbase.com/favicon.png",
  "actions": [
    {
      "id": "listSessions",
      "label": "List signed-in accounts",
      "description": "Discover the currently authenticated Coinbase account.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "label",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "login",
      "label": "Sign in to Coinbase",
      "description": "Open Coinbase sign-in for manual authentication.",
      "baseUrl": "https://www.coinbase.com/login?authuser=00000000-0000-0000-0000-000000000000&action=add_account&returnTo=https%3A%2F%2Fwww.coinbase.com%2Fhome",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "null"
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "getProfile",
      "label": "Get account profile",
      "description": "Read the signed-in account name, email, time zone, and native currency.",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "nativeCurrency": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "timeZone",
          "nativeCurrency"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "listAccounts",
      "label": "List asset balances",
      "description": "Read Coinbase asset accounts and balances with source pagination. Amounts are asset units, not fiat valuations.",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25
          },
          "cursor": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                },
                "currencyName": {
                  "type": "string"
                },
                "balance": {
                  "type": "string"
                },
                "primary": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "type",
                "currency",
                "currencyName",
                "balance",
                "primary"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      }
    }
  ]
}