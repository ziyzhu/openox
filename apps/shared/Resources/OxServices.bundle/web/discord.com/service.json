{
  "domain": "discord.com",
  "name": "Discord",
  "description": "Browse your Discord servers, visible channels, and the latest rendered messages. Read-only; sign-in required.",
  "baseUrl": "https://discord.com/channels/@me",
  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Open Discord sign-in",
      "description": "Open Discord to sign in.",
      "baseUrl": "https://discord.com/login",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "getSignInState",
      "label": "Check Discord sign-in",
      "description": "Check whether the Discord web app is signed in.",
      "baseUrl": "https://discord.com/channels/@me",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "listServers",
      "label": "List Discord servers",
      "description": "List servers currently available in the Discord server sidebar.",
      "baseUrl": "https://discord.com/channels/@me",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "unread": {
                  "type": "boolean"
                },
                "mentionCount": {
                  "type": "integer"
                },
                "selected": {
                  "type": "boolean"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "unread",
                "mentionCount",
                "selected",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "rendered"
            ]
          },
          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "scope",
          "complete"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "listChannels",
      "label": "List Discord channels",
      "description": "Open a server and list its currently rendered channels.",
      "baseUrl": "https://discord.com/channels/@me",
      "inputSchema": {
        "type": "object",
        "properties": {
          "serverId": {
            "type": "string",
            "pattern": "^[0-9]{5,30}$"
          }
        },
        "required": [
          "serverId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "serverId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "voice",
                    "category",
                    "other"
                  ]
                },
                "private": {
                  "type": "boolean"
                },
                "selected": {
                  "type": "boolean"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "type",
                "private",
                "selected",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "rendered"
            ]
          },
          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "serverId",
          "items",
          "scope",
          "complete"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "searchMessages",
      "label": "Search Discord messages",
      "description": "Search message text across a server and return complete rendered matches for a bounded query.",
      "baseUrl": "https://discord.com/channels/@me",
      "inputSchema": {
        "type": "object",
        "properties": {
          "serverId": {
            "type": "string",
            "pattern": "^[0-9]{5,30}$"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "serverId",
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "serverId": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "channelId": {
                  "type": "string"
                },
                "author": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "timestamp": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "content": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "channelId",
                "author",
                "timestamp",
                "content",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "serverId",
          "query",
          "total",
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "getMessages",
      "label": "Read Discord messages",
      "description": "Open a server channel and read the latest messages currently rendered by Discord.",
      "baseUrl": "https://discord.com/channels/@me",
      "inputSchema": {
        "type": "object",
        "properties": {
          "serverId": {
            "type": "string",
            "pattern": "^[0-9]{5,30}$"
          },
          "channelId": {
            "type": "string",
            "pattern": "^[0-9]{5,30}$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        },
        "required": [
          "serverId",
          "channelId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "serverId": {
            "type": "string"
          },
          "channelId": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "author": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "timestamp": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "content": {
                  "type": "string"
                },
                "attachments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "name": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "url",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "author",
                "timestamp",
                "content",
                "attachments",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "rendered"
            ]
          },
          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "serverId",
          "channelId",
          "items",
          "scope",
          "complete"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    }
  ],
  "faviconUrl": "https://t2.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=https://discord.com&size=128"
}