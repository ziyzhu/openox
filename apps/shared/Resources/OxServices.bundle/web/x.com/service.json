  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in to X",
      "description": "X sign-in URL.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getSignInState",
      "label": "Check provider sign-in",
      "description": "Checks whether you are signed in to X.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getProfile",
      "label": "Get user profile",
      "description": "Fetch an X user profile (bio, follower counts, etc.). Defaults to the logged-in user when no username is given.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_]{1,15}$"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/profile"
      },
      "defaultArgs": {
        "username": "elonmusk"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "getTweet",
      "label": "Get post",
      "description": "Fetches one X post by post ID or status URL, including media, quoted-post, card, and engagement metadata.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tweetId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "tweetId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/tweet"
      },
      "defaultArgs": {
        "tweetId": "20"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "listTweets",
      "label": "List user tweets",
      "description": "Recent tweets from a user (excludes pinned). Defaults to the logged-in user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_]{1,15}$"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 20
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/tweetPage"
      },
      "defaultArgs": {
        "username": "elonmusk"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "listUserReplies",
      "label": "List user replies",
      "description": "Recent posts and replies from an X user. Defaults to the logged-in user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_]{1,15}$"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 20
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/tweetPage"
      },
      "defaultArgs": {
        "username": "elonmusk"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "listUserMedia",
      "label": "List user media",
      "description": "Recent media posts from an X user’s Media tab. Defaults to the logged-in user.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_]{1,15}$"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 20
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/tweetPage"
      },
      "defaultArgs": {
        "username": "elonmusk"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "searchTweets",
      "label": "Search tweets",
      "description": "Searches X posts and supports familiar filters such as exact phrases, posts from an account, and posts since a date.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "enum": [
              "top",
              "live",
              "photos",
              "videos"
            ],
            "default": "top"
          },
          "from": {
            "type": "string",
            "pattern": "^@?[A-Za-z0-9_]{1,15}$"
          },
          "has": {
            "type": "string",
            "enum": [
              "media",
              "images",
              "videos",
              "links",
              "replies"
            ]
          },
          "exclude": {
            "type": "string",
            "enum": [
              "replies",
              "retweets",
              "media",
              "links"
            ]
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 15
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/tweetPage"
      },
      "defaultArgs": {
        "query": "claude ai"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "listTimeline",
      "label": "List home timeline",
      "description": "Logged-in user's home timeline. type=for-you (algorithmic, default) or following (chronological).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "for-you",
              "following"
            ],
            "default": "for-you"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/tweetPage"
      },
      "defaultArgs": {
        "type": "for-you"
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "listThread",
      "label": "List tweet thread",
      "description": "Original tweet + reply thread for a given tweet id or status URL.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tweetId": {
            "type": "string",
            "minLength": 1
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          }
        },
        "required": [
          "tweetId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/threadEntry"
            }
          },
          "nextCursor": {
            "type": [
              "string",
