{
  "domain": "clubautomation.com",
  "faviconUrl": "https://openox.ai/assets/services/clubautomation.com/favicon.png",
  "name": "Club Automation",
  "description": "Member portal access for club registration and lesson availability.",
  "baseUrl": "https://tcsp.clubautomation.com/index.php",
  "actions": [
    {
      "id": "listSessions",
      "label": "Find signed-in membership",
      "description": "Check the selected club portal for a currently authenticated membership.",
      "requireAuth": false,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "label",
            "url"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "id": "login",
      "label": "Sign in to club portal",
      "description": "Use a saved account on the inspected password form; leave security checks and unsupported steps to the user.",
      "requireAuth": false,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "null"
      }
    },
    {
      "id": "getClassAvailability",
      "label": "Check class availability",
      "description": "Read class description, dated sessions, instructors, and registration status without registering.",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "details"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "getClassQuote",
      "label": "Check class price",
      "description": "Read the signup price preview for an open class session without selecting a member, adding to cart, or registering.",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "details"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "prepareThursdayGroupRegistration",
      "label": "Prepare Thursday group registration",
      "description": "Open the November 5 small-group registration and select the signed-in adult for review. Does not register, add to cart, or charge.",
      "baseUrl": "https://tcsp.clubautomation.com/calendar/event-info?id=1179883",
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "ready",
          "details"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "listClasses",
      "label": "Find drop-in classes",
      "description": "Find currently listed drop-in classes by name without registering.",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "query",
          "limit"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "baseUrl": "https://tcsp.clubautomation.com/calendar/classes"
    },
    {
      "id": "prepareClassRegistration",
      "label": "Prepare lesson registration",
      "description": "Open a specific dated lesson and select the sole approved profile for user review without registering or charging.",
      "baseUrl": "https://tcsp.clubautomation.com/calendar/event-info?id={id}",
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "scheduleId": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "id",
          "scheduleId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "ready",
          "details"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "getCourtAvailability",
      "label": "Check court openings",
      "description": "Search dated court or hitting-lane openings without selecting a time, holding a court, or booking.",
      "baseUrl": "https://tcsp.clubautomation.com/event/reserve-court-new",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "durationMinutes": {
            "type": "integer",
            "enum": [
              30,
              60,
              75
            ]
          }
        },
        "required": [
          "date",
          "durationMinutes"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer"
          },
          "times": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": {
                  "type": "string"
                },
                "facility": {
                  "type": "string"
                }
              },
              "required": [
                "time",
                "facility"
              ],
              "additionalProperties": false
            }
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "durationMinutes",
          "times",
          "message"
        ],
        "additionalProperties": false
      }
    }
  ]
}
