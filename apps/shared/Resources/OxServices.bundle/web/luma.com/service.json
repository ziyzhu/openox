{
  "domain": "luma.com",
  "faviconUrl": "https://openox.ai/assets/services/luma.com/favicon.png",
  "name": "Luma",
  "description": "Browse public Seattle Luma events and your signed-in upcoming or past Luma events, with attendance and registration status.",
  "baseUrl": "https://luma.com/home",
  "actions": [
    {
      "id": "listSessions",
      "label": "List signed-in accounts",
      "description": "Discover the currently authenticated account in this website context; reject unclassified responses.",
      "requireAuth": false,
      "requireApproval": false,
      "baseUrl": "https://luma.com/home",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "url"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "id": "login",
      "label": "Sign in",
      "description": "Prepare the existing website sign-in page for user interaction.",
      "requireAuth": false,
      "requireApproval": false,
      "baseUrl": "https://luma.com/login",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "null"
      }
    },
    {
      "id": "listSeattleEvents",
      "label": "List Seattle events",
      "description": "List public upcoming Luma events in Seattle with local dates, locations, registration status, and RSVP links.",
      "requireAuth": false,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "startAt",
                "endAt",
                "timezone",
                "location",
                "registrationStatus",
                "waitlistActive",
                "attendanceStatus",
                "eventUrl"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "startAt": {
                  "type": "string"
                },
                "endAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "timezone": {
                  "type": "string"
                },
                "location": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "registrationStatus": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "waitlistActive": {
                  "type": "boolean"
                },
                "attendanceStatus": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "eventUrl": {
                  "type": "string"
                }
              }
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    {
      "id": "listMyEvents",
      "label": "List my Luma events",
      "description": "List your signed-in upcoming or past Luma events, including attendance status and RSVP links.",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "period"
        ],
        "properties": {
          "period": {
            "type": "string",
            "enum": [
              "upcoming",
              "past"
            ],
            "description": "Whether to list upcoming or past events."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 25
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "startAt",
                "endAt",
                "timezone",
                "location",
                "registrationStatus",
                "waitlistActive",
                "attendanceStatus",
                "eventUrl"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "startAt": {
                  "type": "string"
                },
                "endAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "timezone": {
                  "type": "string"
                },
                "location": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "registrationStatus": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "waitlistActive": {
                  "type": "boolean"
                },
                "attendanceStatus": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "eventUrl": {
                  "type": "string"
                }
              }
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  ]
