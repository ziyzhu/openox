{
  "domain": "docs.google.com",
  "faviconUrl": "https://openox.ai/assets/services/docs.google.com/favicon.png",
  "name": "Google Forms",
  "description": "Read the signed-in Google Forms home screen and open new or existing forms for editing.",
  "baseUrl": "https://docs.google.com/forms/u/0/",
  "actions": [
    {
      "id": "listSessions",
      "label": "List signed-in accounts",
      "description": "Discover the currently authenticated account in this website context; reject unclassified responses.",
      "requireAuth": false,
      "requireApproval": false,
      "baseUrl": "https://docs.google.com/forms/u/0/",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "url"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "id": "login",
      "label": "Sign in",
      "description": "Prepare the existing website sign-in page for user interaction.",
      "requireAuth": false,
      "requireApproval": false,
      "baseUrl": "https://docs.google.com/forms/u/0/",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "null"
      }
    },
    {
      "id": "getCurrentAccount",
      "label": "Get current Forms account",
      "description": "Return the currently signed-in Google Forms account shown by the interface.",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "email"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "listRecentForms",
      "label": "List recent forms",
      "description": "List forms currently rendered on the Google Forms home screen.",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "openBlankForm",
      "label": "Open blank form",
      "description": "Create and open a blank Google Form for your review. The new form is created in Google Drive.",
      "requireAuth": true,
      "requireApproval": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    }
  ]
}
