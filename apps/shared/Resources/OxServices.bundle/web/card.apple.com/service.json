{
  "domain": "card.apple.com",
  "name": "Apple Card",
  "description": "Apple Card web account access. Sign in and discover the authenticated card account. Read-only balance support requires authenticated verification; no payment actions.",
  "baseUrl": "https://card.apple.com/",
  "faviconUrl": "https://openox.ai/assets/services/card.apple.com/favicon.png",
  "actions": [
    {
      "id": "listSessions",
      "label": "Find signed-in Apple Card account",
      "description": "Discover the authenticated Apple Card account from the live application store; confirmed signed-out pages return no sessions.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "label",
            "url"
          ],
          "additionalProperties": false
        }
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "login",
      "label": "Sign in to Apple Card",
      "description": "Open Apple’s embedded Apple Account sign-in for manual authentication. No passwords are handled by this service.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "null"
      },
      "requireAuth": false,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "getExpenseExportOptions",
      "label": "Read expense export options",
      "description": "Read the Statements section and available transaction export options without changing account data.",
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statementsAvailable",
          "exportAvailable",
          "controls",
          "notices"
        ],
        "properties": {
          "statementsAvailable": {
            "type": "boolean"
          },
          "exportAvailable": {
            "type": "boolean"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tag",
                "label",
                "id"
              ],
              "properties": {
                "tag": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              }
            }
          },
          "notices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "id": "getBalanceSummary",
      "label": "Read card balance summary",
      "description": "Read explicitly labeled balance amounts from the authenticated Apple Card page; never infers missing amounts as zero.",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "balances",
          "checkedAt"
        ],
        "properties": {
          "balances": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "displayAmount",
                "currency"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "displayAmount": {
                  "type": "string"
                },
                "currency": {
                  "type": "string"
                }
              }
            }
          },
          "checkedAt": {
            "type": "string"
          }
        }
      }
    }
  ]
}
