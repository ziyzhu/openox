          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "getPortfolioDashboard",
      "label": "Get portfolio dashboard",
      "description": "Summarizes each app and the portfolio across App Store analytics for a date range, including previous-period comparisons. Sign-in required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "minLength": 10,
            "description": "Start date as YYYY-MM-DD or an ISO date-time."
          },
          "endDate": {
            "type": "string",
            "minLength": 10,
            "description": "End date as YYYY-MM-DD or an ISO date-time."
          },
          "frequency": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "month"
            ],
            "default": "day"
          },
          "includeRemoved": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "startDate",
          "endDate"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "apps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "appId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "removed": {
                  "type": "boolean"
                },
                "metrics": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "metric": {
                        "type": "string"
                      },
                      "total": {
                        "type": "number"
                      },
                      "previousTotal": {
                        "type": "number"
                      },
                      "percentChange": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "metric",
                      "total",
                      "previousTotal",
                      "percentChange"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "appId",
                "name",
                "removed",
                "metrics"
              ],
              "additionalProperties": false
            }
          },
          "portfolio": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "metric": {
                  "type": "string"
                },
                "total": {
                  "type": "number"
                },
                "previousTotal": {
                  "type": "number"
                },
                "percentChange": {
                  "type": "number"
                }
              },
              "required": [
                "metric",
                "total",
                "previousTotal",
                "percentChange"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "apps",
          "portfolio"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "listCustomerReviews",
      "label": "List customer reviews",
      "description": "Lists customer ratings and reviews for an app, optionally filtered by territory. Sign-in required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "minLength": 1
          },
          "territory": {
            "type": "string",
            "minLength": 2,
            "maxLength": 3,
            "description": "Optional App Store territory code."
          },
          "sort": {
            "type": "string",
            "enum": [
              "newest",
              "oldest",
              "highestRating",
              "lowestRating"
            ],
            "default": "newest"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          }
        },
        "required": [
          "appId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "rating": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "reviewerNickname": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string"
                },
                "territory": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "rating",
                "title",
                "body",
                "reviewerNickname",
                "createdAt",
                "territory"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": true
    },
