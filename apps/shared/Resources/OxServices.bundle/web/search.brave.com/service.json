{
  "domain": "search.brave.com",
  "name": "Brave Search",
  "faviconUrl": "https://openox.ai/assets/services/search.brave.com/favicon.png",
  "description": "Search the public web with Brave Search without signing in.",
  "baseUrl": "https://search.brave.com/",
  "actions": [{
    "id": "search",
    "label": "Search",
    "description": "Search the public web. Returns a bounded result window, not exhaustive coverage. Human verification is reported as a failure.",
    "baseUrl": "https://search.brave.com/search?q={query}&source=web",
    "inputSchema": {"type":"object","properties":{"query":{"type":"string","minLength":1,"maxLength":1000},"limit":{"type":"integer","minimum":1,"maximum":50,"default":10},"cursor":{"type":"string","minLength":1}},"required":["query"],"additionalProperties":false},
    "outputSchema": {"type":"object","properties":{"items":{"type":"array","items":{"type":"object","properties":{"title":{"type":"string","minLength":1},"url":{"type":["string","null"]},"snippet":{"type":["string","null"]}},"required":["title","url","snippet"],"additionalProperties":false}},"nextCursor":{"type":["string","null"]},"scope":{"type":"string","minLength":1},"coverage":{"type":"string","enum":["complete","partial","unknown"]}},"required":["items","nextCursor","scope","coverage"],"additionalProperties":false},
    "requireAuth": false,
    "requireApproval": false
  }]
}
