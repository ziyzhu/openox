      "requireApproval": false
    },
    {
      "id": "searchLocations",
      "label": "Search ride locations",
      "description": "Search Uber pickup or drop-off places around supplied coordinates. Returns one bounded suggestion set, not a paginated catalog.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "type": {
            "type": "string",
            "enum": [
              "PICKUP",
              "DROPOFF"
            ],
            "default": "DROPOFF"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          }
        },
        "required": [
          "query",
          "latitude",
          "longitude"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "addressLine1": {
                  "type": "string"
                },
                "addressLine2": {
                  "type": "string"
                },
                "provider": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "confidence": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "addressLine1",
                "addressLine2",
                "provider",
                "confidence"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false,
      "baseUrl": "https://m.uber.com/go/home"
    },
