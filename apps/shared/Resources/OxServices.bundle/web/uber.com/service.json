    {
      "id": "listTrips",
      "label": "List past trips",
      "description": "Read past ride activity with source pagination. Cursor is passed through unchanged.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 5
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
