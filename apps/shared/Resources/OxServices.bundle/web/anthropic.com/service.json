{
  "domain": "anthropic.com",
  "name": "Anthropic Research & Engineering",
  "description": "Read public Anthropic engineering posts and research articles. Handles server-rendered content hidden for entrance animations; no account access.",
  "baseUrl": "https://www.anthropic.com/engineering",
  "actions": [
    {
      "id": "listPosts",
      "label": "List engineering posts",
      "description": "Expand the native engineering listing and return dated article links. Coverage is partial if the requested limit or safety bound is reached; no synthetic pagination cursor is invented.",
      "blocking": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 100
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "excerpt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "title",
                "url",
                "date",
                "excerpt"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverage": {
            "type": "string",
            "enum": [
              "complete",
              "partial"
            ]
          },
          "totalLoaded": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "coverage",
          "totalLoaded"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getPost",
      "label": "Read Anthropic article",
      "description": "Read a public research or engineering article by its source URL, preserving headings, paragraphs and links. Rejects missing pages, challenges and incomplete content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "url",
          "date",
          "description",
          "text",
          "links"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    }
  ]
}
