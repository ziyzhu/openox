{
  "domain": "chat.deepseek.com",
  "name": "DeepSeek",
  "description": "Search saved DeepSeek chats, read server-backed conversation history, reopen recent chats, and send text with approval.",
  "baseUrl": "https://chat.deepseek.com/",
  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in",
      "description": "Open DeepSeek sign-in.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "getSignInState",
      "label": "Check sign-in",
      "description": "Check the server account using a fresh website-owned request.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "getCurrentConversation",
      "label": "Read current chat",
      "description": "Read up to 100 currently rendered messages. Does not load older messages.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "renderedOnly": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "messages",
          "renderedOnly"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "openConversation",
      "label": "Open recent chat",
      "description": "Open an exact unique title from the loaded sidebar and read rendered messages. Older unlisted chats are unsupported.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "renderedOnly": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "messages",
          "renderedOnly"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "chat",
      "label": "Start a chat",
      "description": "Send one message in a new DeepSeek conversation. Pending does not confirm submission; inspect before retrying.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "pending"
            ]
          },
          "submissionConfirmed": {
            "type": "boolean"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "reply": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "submissionConfirmed",
          "url",
          "reply"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "continueChat",
      "label": "Continue a chat",
      "description": "Open an exact unique loaded-sidebar title and send one follow-up. Pending does not confirm submission; never retry blindly.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "title",
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "pending"
            ]
          },
          "submissionConfirmed": {
            "type": "boolean"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "reply": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "submissionConfirmed",
          "url",
          "reply"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "searchConversations",
      "label": "Search saved chats",
      "description": "Search saved message content through DeepSeek native search. Results are message-level hits and may repeat a conversation ID. Continue with the same query and exact source cursor. Partial timeout pages expose their continuation. Read returned conversation IDs with getConversation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "cursor": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "messageId": {
                  "type": "string"
                },
                "excerpt": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "url",
                "messageId",
                "excerpt"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "partial": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "partial"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "getConversation",
      "label": "Read saved conversation",
      "description": "Read the latest 100 messages of the current server branch by ID, including older chats returned by search. Excludes reasoning fragments; does not navigate or send.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]+$",
            "maxLength": 100
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "messages",
          "truncated"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    }
  ],
  "faviconUrl": "https://fe-static.deepseek.com/chat/icon-180.png"
}