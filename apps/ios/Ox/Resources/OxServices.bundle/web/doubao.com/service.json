{
  "domain": "doubao.com",
  "name": "Doubao",
  "description": "Search saved message content, read rendered chats, reopen recent Doubao conversations, and send with approval. Search continuation and title-only matching are not supported.",
  "baseUrl": "https://www.doubao.com/chat/",
  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in",
      "description": "Open Doubao sign-in.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false,
      "baseUrl": "https://www.doubao.com/robots.txt"
    },
    {
      "id": "getSignInState",
      "label": "Check sign-in",
      "description": "Check a fresh server-rendered session response, not local browser state.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false,
      "baseUrl": "https://www.doubao.com/robots.txt"
    },
    {
      "id": "getCurrentConversation",
      "label": "Read current chat",
      "description": "Read bounded rendered messages and loaded sidebar titles. Does not return complete history or paginate older chats.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "conversationRef": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "renderedOnly": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          },
          "recentConversations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "conversationRef": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "conversationRef"
              ],
              "additionalProperties": false
            }
          },
          "interfaceState": {
            "type": "object",
            "properties": {
              "editorCount": {
                "type": "integer"
              },
              "draftLength": {
                "type": "integer"
              },
              "docLength": {
                "type": "integer"
              },
              "editorInitialized": {
                "type": "boolean"
              },
              "sameView": {
                "type": "boolean"
              },
              "editorStateSynchronized": {
                "type": "boolean"
              },
              "animationFrameObserved": {
                "type": "boolean"
              }
            },
            "required": [
              "editorCount",
              "draftLength",
              "docLength",
              "editorInitialized",
              "sameView",
              "editorStateSynchronized",
              "animationFrameObserved"
            ],
            "additionalProperties": false
          },
          "lastSubmissionEvents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                }
              },
              "required": [
                "method",
                "path",
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "url",
          "conversationRef",
          "messages",
          "renderedOnly",
          "truncated",
          "recentConversations",
          "interfaceState",
          "lastSubmissionEvents"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "openConversation",
      "label": "Open recent chat",
      "description": "Open a unique exact title from the loaded sidebar. Older unloaded chats and ambiguous titles are rejected.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "conversationRef": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "conversationRef"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "chat",
      "label": "New chat",
      "description": "Start a fresh text chat after approval. Refuses to discard an existing draft. A reply may still be generating; pending submissions must not be repeated.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "conversationRef": {
            "type": "string"
          },
          "response": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "reply_observed",
              "pending"
            ]
          },
          "submissionConfirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "conversationRef",
          "response",
          "status",
          "submissionConfirmed"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "continueChat",
      "label": "Continue current chat",
      "description": "Send one follow-up after approval using the current conversationRef. Rejects stale references and existing drafts. Read current chat after pending results; do not resend.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "required": [
          "conversationRef",
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "conversationRef": {
            "type": "string"
          },
          "response": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "reply_observed",
              "pending"
            ]
          },
          "submissionConfirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "conversationRef",
          "response",
          "status",
          "submissionConfirmed"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "diagnoseComposer",
      "label": "Test editor without sending",
      "description": "Temporarily insert a fixed diagnostic draft, inspect Send readiness, and remove only that exact draft. Never clicks Send; refuses existing drafts.",
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "draftAccepted": {
            "type": "boolean"
          },
          "draftCleared": {
            "type": "boolean"
          },
          "editorStateSynchronized": {
            "type": "boolean"
          },
          "buttonCount": {
            "type": "integer"
          },
          "sendHandlerPresent": {
            "type": "boolean"
          },
          "sendEnabled": {
            "type": "boolean"
          },
          "buttonConnected": {
            "type": "boolean"
          }
        },
        "required": [
          "draftAccepted",
          "draftCleared",
          "editorStateSynchronized",
          "buttonCount",
          "sendHandlerPresent",
          "sendEnabled",
          "buttonConnected"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "searchConversations",
      "label": "Search saved messages (experimental)",
      "description": "Search saved message content using Doubao native search and website-default date range; returns matching conversations. Title-only matches are excluded. Source continuation is not verified: broad searches with more results throw and require a narrower query. Returned URLs open chats; existing openConversation remains recent-sidebar only. Experimental: some native result formats are unsupported and fail explicitly; an empty-search test encountered such a format.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          },
          "scope": {
            "type": "string",
            "enum": [
              "message-content"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor",
          "scope"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true,
      "baseUrl": "https://www.doubao.com/chat/"
    },
    {
      "id": "listModels",
      "label": "List provider models",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "input": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "text",
                      "image",
                      "pdf"
                    ]
                  }
                },
                "contextTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "outputTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "streaming": {
                  "type": "boolean"
                },
                "cancellation": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "temperature",
                      "maxTokens"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "name",
                "input",
                "contextTokens",
                "outputTokens",
                "streaming",
                "cancellation",
                "options"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "models"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://www.doubao.com/chat/"
    },
    {
      "id": "startModelGeneration",
      "label": "Start model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant",
                    "tool"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "mimeType"
              ],
              "additionalProperties": false
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "temperature": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "temperature",
              "maxTokens"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "modelId",
          "messages",
          "attachments",
          "options"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          },
          "submission": {
            "type": "string",
            "enum": [
              "uncertain",
              "confirmed"
            ]
          }
        },
        "required": [
          "generationId",
          "submission"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "baseUrl": "https://www.doubao.com/chat/"
    },
    {
      "id": "readModelGeneration",
      "label": "Read model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          },
          "after": {
            "type": "integer",
            "minimum": 0
          },
          "waitMilliseconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "generationId",
          "after",
          "waitMilliseconds"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "completed"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "failed"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "contextOverflow",
                        "rateLimited",
                        "network",
                        "authentication",
                        "unsupportedInput",
                        "provider"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "message",
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "nextCursor",
          "events"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://www.doubao.com/chat/"
    },
    {
      "id": "cancelModelGeneration",
      "label": "Cancel model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          }
        },
        "required": [
          "generationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "cancelled",
              "requested",
              "completed",
              "unsupported"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "baseUrl": "https://www.doubao.com/chat/"
    }
  ],
  "faviconUrl": "https://openox.ai/assets/services/doubao.com/favicon.png"
}