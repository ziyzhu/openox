{
  "domain": "www.chictr.org.cn",
  "name": "Chinese Clinical Trial Registry",
  "description": "A WHO primary registry for clinical research. Search registered trials by public title and read study designs, eligibility criteria, interventions, locations, outcomes, recruitment details, and data-sharing plans. Public and read-only; no sign-in required.",
  "baseUrl": "https://www.chictr.org.cn/images/fav.ico",
  "$defs": {
    "searchResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The registry's internal trial identifier used to read the full record."
        },
        "registrationNumber": {
          "type": "string",
          "description": "The trial's public ChiCTR registration number."
        },
        "title": {
          "type": "string"
        },
        "institution": {
          "type": "string"
        },
        "studyType": {
          "type": "string"
        },
        "registeredAt": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "registrationNumber",
        "title",
        "institution",
        "studyType",
        "registeredAt",
        "url"
      ],
      "additionalProperties": false
    },
    "intervention": {
      "type": "object",
      "properties": {
        "group": {
          "type": "string"
        },
        "intervention": {
          "type": "string"
        },
        "sampleSize": {
          "type": "integer"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "group",
        "intervention"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "country": {
          "type": "string"
        },
        "province": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "institution": {
          "type": "string"
        },
        "level": {
          "type": "string"
        }
      },
      "required": [
        "country",
        "province",
        "city",
        "institution",
        "level"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "timepoint": {
          "type": "string"
        },
        "method": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "timepoint",
        "method"
      ],
      "additionalProperties": false
    }
  },
  "actions": [
    {
      "id": "searchTrials",
      "label": "Search clinical trials",
      "description": "Searches registered trials by words in their public titles and returns registration numbers, institutions, study types, dates, and record links.",
      "baseUrl": "https://www.chictr.org.cn/searchprojEN.html?page={cursor}&title={query}&btngo=btn",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Text or identifier to find."
          },
          "cursor": {
            "type": "string",
            "description": "Page cursor returned by the previous search."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/searchResult"
            }
          },
          "totalCount": {
            "type": "integer"
          },
          "nextCursor": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "totalCount",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {
        "query": "cardiology"
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getTrial",
      "label": "Read a clinical trial",
      "description": "Reads a registered trial's study design, eligibility criteria, interventions, locations, outcomes, recruitment details, ethics status, and data-sharing plan.",
      "baseUrl": "https://www.chictr.org.cn/showprojEN.html?proj={id}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Internal trial identifier from a search result."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "registrationNumber": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "interventions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/intervention"
            }
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/location"
            }
          },
          "outcomes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/outcome"
            }
          },
          "updatedAt": {
            "type": "string"
          },
          "registeredAt": {
            "type": "string"
          },
          "registrationStatus": {
            "type": "string"
          },
          "scientificTitle": {
            "type": "string"
          },
          "acronym": {
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "studyLeader": {
            "type": "string"
          },
          "institution": {
            "type": "string"
          },
          "ethicsApproved": {
            "type": "string"
          },
          "ethicsCommittee": {
            "type": "string"
          },
          "primarySponsor": {
            "type": "string"
          },
          "fundingSource": {
            "type": "string"
          },
          "targetDisease": {
            "type": "string"
          },
          "targetDiseaseCode": {
            "type": "string"
          },
          "studyType": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "design": {
            "type": "string"
          },
          "objectives": {
            "type": "string"
          },
          "inclusionCriteria": {
            "type": "string"
          },
          "exclusionCriteria": {
            "type": "string"
          },
          "studyStart": {
            "type": "string"
          },
          "studyEnd": {
            "type": "string"
          },
          "recruitmentStart": {
            "type": "string"
          },
          "recruitmentEnd": {
            "type": "string"
          },
          "recruitingStatus": {
            "type": "string"
          },
          "minimumAge": {
            "type": "string"
          },
          "maximumAge": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "blinding": {
            "type": "string"
          },
          "ipdSharing": {
            "type": "string"
          },
          "ipdSharingPlan": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "registrationNumber",
          "title",
          "url",
          "interventions",
          "locations",
          "outcomes"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {
        "id": "335018"
      },
      "requireApproval": false,
      "requireAuth": false
    }
  ],
  "faviconUrl": "https://openox.ai/assets/services/www.chictr.org.cn/favicon.png"
}