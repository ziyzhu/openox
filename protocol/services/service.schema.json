{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "domain",
    "name",
    "baseUrl",
    "actions"
  ],
  "properties": {
    "domain": {
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "baseUrl": {
      "minLength": 1,
      "type": "string"
    },
    "$defs": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "additionalProperties": true,
          "type": "object",
          "properties": {}
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "label",
          "inputSchema",
          "outputSchema",
          "requireApproval",
          "requireAuth"
        ],
        "properties": {
          "id": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "baseUrl": {
            "minLength": 1,
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "inputSchema": {
            "additionalProperties": true,
            "type": "object",
            "properties": {}
          },
          "outputSchema": {
            "additionalProperties": true,
            "type": "object",
            "properties": {}
          },
          "defaultArgs": {},
          "requireApproval": {
            "type": "boolean"
          },
          "requireAuth": {
            "type": "boolean"
          }
        }
      }
    },
    "locales": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "actions": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "additionalProperties": false,
                  "type": "object",
                  "properties": {
                    "label": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$id": "https://oxcraft.ai/schemas/service-v1.json"
}
