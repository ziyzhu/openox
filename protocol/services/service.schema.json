{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxcraft.ai/schemas/service-v1.json",
  "title": "OpenOx Web Service",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain", "name", "baseUrl", "actions"],
  "properties": {
    "domain": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "baseUrl": {
      "type": "string",
      "minLength": 1
    },
    "$defs": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/locale"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "inputSchema", "outputSchema", "requireApproval", "requireAuth"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "baseUrl": {
          "type": "string",
          "minLength": 1
        },
        "blocking": {
          "type": "boolean"
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "defaultArgs": true,
        "requireApproval": {
          "type": "boolean"
        },
        "requireAuth": {
          "type": "boolean"
        }
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
