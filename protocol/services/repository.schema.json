{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oxcraft.ai/schemas/repository-v1.json",
  "title": "OpenOx Service Repository",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "services"],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "services": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 253,
        "pattern": "^(?:web|ios|mcp):[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
      }
    }
  }
}
