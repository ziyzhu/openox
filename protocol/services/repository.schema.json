{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$id": "https://oxcraft.ai/schemas/repository-v1.json",
  "type": "object",
  "required": [
    "version",
    "name",
    "services"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "number"
    },
    "name": {
      "minLength": 1,
      "maxLength": 100,
      "type": "string"
    },
    "contentHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "services": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "minLength": 5,
        "maxLength": 253,
        "pattern": "^(?:web|ios|mcp):[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
        "type": "string"
      }
    }
  }
}
