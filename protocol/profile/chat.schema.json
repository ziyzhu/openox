{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$id": "https://openox.ai/schemas/chat-metadata-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "isFavorite",
    "attachedServiceDomains"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "id": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "type": "string"
    },
    "createdAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "type": "string"
    },
    "lastActivity": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "isFavorite": {
      "type": "boolean"
    },
    "modelID": {
      "type": "string"
    },
    "clientID": {
      "type": "string"
    },
    "monoRepositoryHash": {
      "type": "string"
    },
    "attachedServiceDomains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preview": {
      "type": "string"
    },
    "hasUnreadResponse": {
      "type": "boolean"
    }
  }
}
