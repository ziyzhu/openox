{
  "domain": "my.pacificsciencecenter.org",
  "name": "Pacific Science Center",
  "description": "Seattle's hands-on science museum. Search events and showtimes, check availability and prices, prepare a ticket cart, finish checkout on the museum's page, and read the completed receipt.",
  "baseUrl": "https://my.pacificsciencecenter.org/events",
  "$defs": {
    "event": {
      "type": "object",
      "properties": {
        "productionSeasonId": {
          "type": "string",
          "description": "Event id used with getShowtime"
        },
        "performanceId": {
          "type": "string",
          "description": "Showtime id used with getShowtime"
        },
        "title": { "type": "string" },
        "dateTime": { "type": "string", "description": "Showtime with Pacific time offset" },
        "displayDate": { "type": "string" },
        "displayTime": { "type": "string" },
        "onSale": { "type": "boolean" },
        "limitedAvailability": { "type": "boolean" },
        "status": { "type": "string" },
        "category": { "type": "string" },
        "pageUrl": { "type": "string" }
      },
      "required": [
        "productionSeasonId",
        "performanceId",
        "title",
        "dateTime",
        "displayDate",
        "displayTime",
        "onSale",
        "limitedAvailability",
        "status",
        "category",
        "pageUrl"
      ],
      "additionalProperties": false
    },
    "ticketType": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Ticket type id" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "maximumQuantity": { "type": "integer" }
      },
      "required": ["id", "name", "price", "currency", "maximumQuantity"],
      "additionalProperties": false
    },
    "zone": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Section id" },
        "name": { "type": "string" },
        "availableCount": { "type": "integer" },
        "maximumQuantity": { "type": "integer" },
        "ticketTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/ticketType" }
        }
      },
      "required": ["id", "name", "availableCount", "maximumQuantity", "ticketTypes"],
      "additionalProperties": false
    },
    "cartTicket": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "quantity": { "type": "integer" },
        "unitPrice": { "type": "number" },
        "total": { "type": "number" }
      },
      "required": ["name", "quantity", "unitPrice", "total"],
      "additionalProperties": false
    },
    "cartItem": {
      "type": "object",
      "properties": {
        "productionSeasonId": { "type": "string" },
        "performanceId": { "type": "string" },
        "title": { "type": "string" },
        "dateTime": { "type": "string" },
        "venue": { "type": "string" },
        "total": { "type": "number" },
        "tickets": {
          "type": "array",
          "items": { "$ref": "#/$defs/cartTicket" }
        }
      },
      "required": ["productionSeasonId", "performanceId", "title", "dateTime", "venue", "total", "tickets"],
      "additionalProperties": false
    }
  },
  "actions": [
    {
      "id": "searchEvents",
      "label": "Search events",
      "description": "Finds matching events and showtimes in a date range, including sale status and limited-availability warnings. Searches the next 30 days when dates are omitted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Event title or category, such as Odyssey, IMAX, or laser"
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "First date to search, YYYY-MM-DD; defaults to today"
          },
          "endDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Last date to search, YYYY-MM-DD; defaults to 30 days after the start"
          }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/event" }
          },
          "nextCursor": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          }
        },
        "required": ["items", "nextCursor"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getShowtime",
      "label": "Showtime details",
      "description": "Checks one showtime's date, venue, current availability, sections, ticket types, prices, and per-order quantity limits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "productionSeasonId": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Event id from event search"
          },
          "performanceId": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Showtime id from event search"
          }
        },
        "required": ["productionSeasonId", "performanceId"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "productionSeasonId": { "type": "string" },
          "performanceId": { "type": "string" },
          "title": { "type": "string" },
          "dateTime": { "type": "string" },
          "venue": { "type": "string" },
          "description": { "type": "string" },
          "available": { "type": "boolean" },
          "zones": {
            "type": "array",
            "items": { "$ref": "#/$defs/zone" }
          },
          "pageUrl": { "type": "string" }
        },
        "required": [
          "productionSeasonId",
          "performanceId",
          "title",
          "dateTime",
          "venue",
          "description",
          "available",
          "zones",
          "pageUrl"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "updateCart",
      "label": "Prepare ticket cart",
      "description": "Adds the selected ticket types to the current cart and returns its items, prices, total, and expiration time. You review, identify yourself or continue as a guest, and pay on the Pacific Science Center checkout page; this action never places the order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "productionSeasonId": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Event id from showtime details"
          },
          "performanceId": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Showtime id from showtime details"
          },
          "zoneId": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Available section id from showtime details"
          },
          "tickets": {
            "type": "array",
            "description": "One or more available ticket types and their quantities",
            "items": {
              "type": "object",
              "properties": {
                "ticketTypeId": {
                  "type": "string",
                  "pattern": "^\\d+$",
                  "description": "Ticket type id from the selected section"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Number of tickets of this type"
                }
              },
              "required": ["ticketTypeId", "quantity"],
              "additionalProperties": false
            }
          }
        },
        "required": ["productionSeasonId", "performanceId", "zoneId", "tickets"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/cartItem" }
          },
          "subtotal": { "type": "number" },
          "total": { "type": "number" },
          "currency": { "type": "string" },
          "expiresAt": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ],
            "description": "When the reserved cart expires, in Pacific time"
          }
        },
        "required": ["items", "subtotal", "total", "currency", "expiresAt"],
        "additionalProperties": false
      },
      "requireApproval": true,
      "requireAuth": false
    },
    {
      "id": "getPaymentUrl",
      "label": "Review ticket checkout",
      "description": "Opens the prepared ticket cart. You can sign in, register, or continue as a guest, then review the cart and pay on Pacific Science Center's page.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": { "type": "string" }
        },
        "required": ["url"],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getPaymentState",
      "label": "Check ticket checkout",
      "description": "Checks whether the ticket cart is awaiting review, has expired, or was completed. A completed checkout includes its order number.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "description": "Checkout episode start, YYYY-MM-DD HH:MM:SS in Pacific time; prevents an earlier order from being mistaken for this checkout"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["none", "pending", "completed"]
          },
          "reference": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          },
          "total": { "type": "number" },
          "currency": { "type": "string" },
          "expiresAt": {
            "type": "string",
            "description": "When a pending cart expires, in Pacific time"
          },
          "completedAt": {
            "type": "string",
            "description": "When a completed order was placed, in Pacific time"
          }
        },
        "required": ["status", "reference"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false,
      "baseUrl": "https://my.pacificsciencecenter.org/events"
    },
    {
      "id": "getOrder",
      "label": "Ticket order receipt",
      "description": "Reads a completed ticket order's date, showtimes, ticket types, quantities, prices, and total without exposing billing or contact details.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Order number from the completed checkout state"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "orderDate": { "type": "string" },
          "items": {
            "type": "array",
            "items": { "$ref": "#/$defs/cartItem" }
          },
          "subtotal": { "type": "number" },
          "total": { "type": "number" },
          "currency": { "type": "string" }
        },
        "required": ["id", "orderDate", "items", "subtotal", "total", "currency"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    }
  ]
}
