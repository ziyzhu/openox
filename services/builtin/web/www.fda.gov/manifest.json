  "actions": [
    {
      "id": "searchSite",
      "label": "Search FDA",
      "description": "Searches official FDA information and returns matching pages, documents, recalls, and selected health references with summaries.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Words or phrases to find."
          },
          "cursor": {
            "type": "string",
            "description": "Page cursor from a previous result. Omit for the first page."
          },
          "limit": {
            "type": "integer",
            "enum": [
              10,
              25,
              50,
              100
            ],
            "default": 25,
            "description": "Number of results per page."
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "newest",
              "oldest"
            ],
            "default": "relevance",
            "description": "Order results by relevance or publication date."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/searchResult"
            }
          },
          "nextCursor": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {
        "query": "aspirin"
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "listRecalls",
      "label": "Browse FDA recalls",
      "description": "Lists FDA recalls newest first. Optionally searches recall text and filters by regulated product or whether FDA has terminated the recall.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Optional words or phrases to find in recall listings."
          },
          "productType": {
            "type": "string",
            "enum": [
              "any",
              "animal-veterinary",
              "biologics",
              "cosmetics",
              "dietary-supplements",
              "drugs",
              "food-beverages",
              "medical-devices",
              "radiation-emitting-products",
              "tobacco"
            ],
            "default": "any",
            "description": "Regulated product category to include."
          },
          "terminated": {
            "type": "string",
            "enum": [
              "any",
              "yes",
              "no"
            ],
            "default": "any",
            "description": "Filter by whether FDA marks a recall as terminated."
          },
          "cursor": {
            "type": "string",
            "description": "Page cursor from a previous result. Omit for the first page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 25,
            "description": "Number of recalls to return."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/recallListItem"
            }
          },
          "nextCursor": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getRecall",
      "label": "Read an FDA recall",
      "description": "Retrieves a recall's dates, company and product details, reason, and full public announcement. Choose a recall from the recall list.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Recall identifier returned by the recall list."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/recall"
      },
      "defaultArgs": {
        "id": "aurobindo-pharma-usa-inc-behalf-aurohealth-issues-voluntary-nationwide-recall-one-1-lot-healthy"
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getDrugLabel",
      "label": "Read an FDA drug label",
      "description": "Returns the newest matching submitted drug label with selected sections such as uses, dosage, warnings, interactions, and contraindications. FDA advises that submitted labeling may differ from currently distributed or approved labeling.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Drug brand, generic name, or NDC to look up."
          },
          "field": {
            "type": "string",
            "enum": [
              "any",
              "brand",
              "generic",
              "ndc"
            ],
            "default": "any",
            "description": "Kind of drug identifier supplied."
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "uses",
                "dosage",
                "warnings",
                "boxedWarning",
                "contraindications",
                "drugInteractions",
                "adverseReactions",
                "patientInformation"
              ]
            },
            "default": [
              "uses",
              "dosage",
              "warnings",
              "contraindications",
              "drugInteractions"
            ],
            "description": "Label sections to return. Request fewer sections for more focused answers."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/drugLabel"
      },
      "defaultArgs": {
        "query": "Advil",
        "field": "brand",
        "sections": [
          "uses",
          "warnings"
        ]
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "searchDrugShortages",
      "label": "Search drug shortages",
      "description": "Searches FDA drug shortage records by drug name and status, returning presentation, availability, reason, company, and update details.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Brand or generic drug name to find."
          },
          "status": {
            "type": "string",
            "enum": [
              "Current",
              "Resolved",
              "Discontinued",
              "Any"
            ],
            "default": "Current",
            "description": "Shortage status to include."
          },
          "cursor": {
            "type": "string",
            "description": "Page cursor from a previous result. Omit for the first page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "Number of shortage records to return."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/drugShortage"
            }
          },
          "total": {
            "type": "integer"
          },
          "nextCursor": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceUrl": {
            "type": "string"
          },
          "dataLastUpdated": {
            "type": "string"
          },
          "disclaimer": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "total",
          "nextCursor",
          "sourceUrl",
          "dataLastUpdated",
          "disclaimer"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {
        "query": "midazolam",
        "status": "Current"
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "lookupDrug",
      "label": "Look up an FDA drug product",
      "description": "Identifies listed drug products and packages by NDC, brand, or generic name. An NDC listing does not mean FDA approval.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ndc": {
            "type": "string",
            "minLength": 1,
            "description": "Product or package NDC, including hyphens when available."
          },
          "brandName": {
            "type": "string",
            "minLength": 1,
            "description": "Drug brand name."
          },
          "genericName": {
            "type": "string",
            "minLength": 1,
            "description": "Drug generic name."
          },
          "cursor": {
            "type": "string",
            "description": "Page cursor from a previous result. Omit for the first page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "Number of products to return."
          }
        },
        "oneOf": [
          {
            "required": [
              "ndc"
            ]
          },
          {
            "required": [
              "brandName"
            ]
          },
          {
            "required": [
              "genericName"
            ]
          }
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/drugProduct"
            }
          },
          "total": {
            "type": "integer"
          },
          "nextCursor": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceUrl": {
            "type": "string"
          },
          "dataLastUpdated": {
            "type": "string"
          },
          "disclaimer": {
            "type": "string"
          },
          "approvalNotice": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "total",
          "nextCursor",
          "sourceUrl",
          "dataLastUpdated",
          "disclaimer",
          "approvalNotice"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {
        "brandName": "Advil"
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "lookupDevice",
      "label": "Look up an FDA medical device",
      "description": "Identifies medical devices by UDI, brand, or catalog number and returns manufacturer, model, distribution, use, MRI, and product-code details.",
      "inputSchema": {
