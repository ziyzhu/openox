{
  "domain": "www.inhousepharmacy.vu",
  "name": "Inhouse Pharmacy",
  "description": "An international online pharmacy. Search medicines, compare product options and prices, prepare a cart for checkout, and review signed-in order history, receipts, payment status, shipping progress, and tracking details.",
  "baseUrl": "https://www.inhousepharmacy.vu/",
  "$defs": {
    "productSummary": {
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "imageUrl": { "type": "string" },
        "activeIngredient": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "description": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "manufacturer": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["productId", "name", "url", "imageUrl", "activeIngredient", "description", "manufacturer"],
      "additionalProperties": false
    },
    "offer": {
      "type": "object",
      "properties": {
        "variantId": { "type": "string" },
        "title": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "inStock": { "type": "boolean" }
      },
      "required": ["variantId", "title", "price", "currency", "inStock"],
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "imageUrl": { "type": "string" },
        "activeIngredient": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "manufacturer": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "productType": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "expiryDate": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "description": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "offers": {
          "type": "array",
          "items": { "$ref": "#/$defs/offer" }
        }
      },
      "required": ["productId", "name", "url", "imageUrl", "activeIngredient", "manufacturer", "productType", "expiryDate", "description", "offers"],
      "additionalProperties": false
    },
    "cartItem": {
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "quantity": { "type": "integer" },
        "subtotal": { "type": "number" }
      },
      "required": ["productId", "name", "url", "quantity", "subtotal"],
      "additionalProperties": false
    },
    "cart": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/cartItem" }
        },
        "total": { "type": "number" },
        "currency": { "type": "string" }
      },
      "required": ["items", "total", "currency"],
      "additionalProperties": false
    },
    "orderProduct": {
      "type": "object",
      "properties": {
        "quantity": { "type": "integer" },
        "name": { "type": "string" },
        "productUrl": { "type": "string" }
      },
      "required": ["quantity", "name", "productUrl"],
      "additionalProperties": false
    },
    "order": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reference": { "type": "string" },
        "date": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "shippingStatus": { "type": "string" },
        "trackingNumber": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "trackingUrl": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "products": {
          "type": "array",
          "items": { "$ref": "#/$defs/orderProduct" }
        },
        "total": { "type": "number" },
        "currency": { "type": "string" }
      },
      "required": ["id", "reference", "date", "paymentMethod", "paymentStatus", "shippingStatus", "trackingNumber", "trackingUrl", "products", "total", "currency"],
      "additionalProperties": false
    },
    "receiptItem": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "quantity": { "type": "integer" },
        "unitPrice": { "type": "number" },
        "total": { "type": "number" }
      },
      "required": ["name", "quantity", "unitPrice", "total"],
      "additionalProperties": false
    }
  },
  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in to Inhouse Pharmacy",
      "description": "Opens the sign-in page for account and order access.",
      "baseUrl": "https://www.inhousepharmacy.vu/robots.txt",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": { "url": { "type": "string" } },
        "required": ["url"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getSignInState",
      "label": "Check Inhouse Pharmacy sign-in",
      "description": "Checks whether you are signed in.",
      "baseUrl": "https://www.inhousepharmacy.vu/robots.txt",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": { "signedIn": { "type": "boolean" } },
        "required": ["signedIn"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "searchProducts",
      "label": "Search products",
      "description": "Searches medicines and returns matching products with ingredients, descriptions, manufacturers, and links.",
      "baseUrl": "https://www.inhousepharmacy.vu/robots.txt",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "minLength": 3, "description": "Medicine, ingredient, or product name to find." }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/$defs/productSummary" } },
          "nextCursor": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "required": ["items", "nextCursor"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getProduct",
      "label": "Product details",
      "description": "Reads a product's ingredient, manufacturer, description, expiry information, available pack options, and current prices.",
      "baseUrl": "https://www.inhousepharmacy.vu/robots.txt",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "minLength": 1, "description": "Product URL from search results." }
        },
        "required": ["url"],
        "additionalProperties": false
      },
      "outputSchema": { "$ref": "#/$defs/product" },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getCart",
      "label": "View cart",
      "description": "Reads the current cart's products, quantities, subtotals, and order total. This does not begin checkout or place an order.",
      "baseUrl": "https://www.inhousepharmacy.vu/robots.txt",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": { "$ref": "#/$defs/cart" },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "addCartItem",
      "label": "Add product to cart",
      "description": "Adds the selected product option and quantity to the cart for later review. This changes the cart but does not place an order or move money.",
      "baseUrl": "https://www.inhousepharmacy.vu/robots.txt",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "minLength": 1, "description": "Product URL from search or product details." },
          "variantId": { "type": "string", "pattern": "^\\d+$", "description": "Available product option ID from product details." },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 20, "default": 1, "description": "Number of the selected option to add." }
        },
        "required": ["url", "variantId"],
        "additionalProperties": false
      },
      "outputSchema": { "$ref": "#/$defs/cart" },
      "requireApproval": true,
      "requireAuth": false
    },
    {
      "id": "listOrders",
      "label": "Order history",
      "description": "Lists signed-in orders with payment status, shipping progress, tracking, products, and totals. Sign-in required.",
      "baseUrl": "https://www.inhousepharmacy.vu/robots.txt",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/$defs/order" } },
          "nextCursor": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "required": ["items", "nextCursor"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "getOrder",
      "label": "Order receipt",
      "description": "Reads a signed-in order's receipt, products, prices, total, payment status, shipping progress, and tracking details. Sign-in required.",
      "baseUrl": "https://www.inhousepharmacy.vu/robots.txt",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "Order ID or reference from order history or a completed checkout." }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "reference": { "type": "string" },
          "date": { "type": "string" },
          "currency": { "type": "string" },
          "paymentMethod": { "type": "string" },
          "paymentStatus": { "type": "string" },
          "shippingStatus": { "type": "string" },
          "trackingNumber": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "trackingUrl": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "items": { "type": "array", "items": { "$ref": "#/$defs/receiptItem" } },
          "total": { "type": "number" }
        },
        "required": ["id", "reference", "date", "currency", "paymentMethod", "paymentStatus", "shippingStatus", "trackingNumber", "trackingUrl", "items", "total"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "getPaymentUrl",
      "label": "Review checkout",
      "description": "Opens the current cart so you can review it and continue through the pharmacy's checkout. Only you can place and pay for the order.",
      "baseUrl": "https://www.inhousepharmacy.vu/robots.txt",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": {
        "type": "object",
        "properties": { "url": { "type": "string" } },
        "required": ["url"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getPaymentState",
      "label": "Check checkout status",
      "description": "Checks whether the cart is awaiting review or checkout produced a new order. It never places or pays for an order.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
            "description": "Checkout episode start in YYYY-MM-DD HH:MM:SS form."
          },
          "previousOrderId": {
            "type": "string",
            "description": "Newest order ID observed before checkout, used to distinguish a newly placed order."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["none", "pending", "completed"] },
          "reference": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "total": { "type": "number" },
          "currency": { "type": "string" },
          "completedAt": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "required": ["status", "reference", "total", "currency", "completedAt"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    }
  ]
}
