{
  "name": "@openox/services",
  "version": "0.1.0",
  "description": "Official built-in service repository for Ox",
  "author": "Ziyuan Zhu",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "repository.js",
    "src/skills.ts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./repository.js",
    "./skills": "./src/skills.ts",
    "./repository.json": "./dist/repository/repository.json",
    "./web/*": "./dist/repository/web/*",
    "./ios/*": "./dist/repository/ios/*",
    "./mcp/*": "./dist/repository/mcp/*"
  },
  "scripts": {
    "build": "bun package-build.ts",
    "export": "bun export.ts",
    "package:check": "bun package-check.ts",
    "prepack": "bun run build"
  },
  "keywords": [
    "openox",
    "services",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyzhu/openox.git",
    "directory": "packages/services"
  },
  "homepage": "https://github.com/ziyzhu/openox/tree/main/packages/services",
  "bugs": {
    "url": "https://github.com/ziyzhu/openox/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@openox/protocol": "0.1.0"
  }
}
