{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:openox:repository:3",
  "title": "OpenOx Host-Repository content contract",
  "$ref": "#/definitions/RepositoryPackage",
  "definitions": {
    "RepositoryPackage": {
      "type": "object",
      "required": [
        "version",
        "name",
        "services",
        "skills"
      ],
      "properties": {
        "version": {
          "type": "number",
          "const": 3
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 253,
            "pattern": "^(?:web|api|ios|mcp):[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
          },
          "maxItems": 256
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 100
          },
          "maxItems": 256
        }
      },
      "additionalProperties": false,
      "$id": "https://openox.ai/schemas/repository-v3.json"
    },
    "ServiceManifest": {
      "type": "object",
      "required": [
        "domain",
        "name",
        "baseUrl",
        "actions"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
        },
        "kind": {
          "type": "string",
          "const": "api"
        },
        "auth": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "none"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "in",
                "name"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "apiKey"
                },
                "in": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "header"
                    },
                    {
                      "type": "string",
                      "const": "query"
                    }
                  ]
                },
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "scheme"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "http"
                },
                "scheme": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "basic"
                    },
                    {
                      "type": "string",
                      "const": "bearer"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "flow",
                "authorizationURL",
                "tokenURL",
                "clientID",
                "redirectURI",
                "scopes",
                "pkce"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "oauth2"
                },
                "flow": {
                  "type": "string",
                  "const": "authorizationCode"
                },
                "authorizationURL": {
                  "type": "string"
                },
                "tokenURL": {
                  "type": "string"
                },
                "clientID": {
                  "type": "string",
                  "minLength": 1
                },
                "redirectURI": {
                  "type": "string"
                },
                "scopes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "pkce": {
                  "type": "string",
                  "const": "S256"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "baseUrl": {
          "type": "string",
          "minLength": 1
        },
        "$defs": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "type": "object",
              "properties": {},
              "additionalProperties": true
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "inputSchema",
              "outputSchema",
              "requireApproval",
              "requireAuth"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "type": "boolean"
              },
              "inputSchema": {
                "type": "object",
                "properties": {},
                "additionalProperties": true
              },
              "outputSchema": {
                "type": "object",
                "properties": {},
                "additionalProperties": true
              },
              "defaultArgs": {},
              "requireApproval": {
                "type": "boolean"
              },
              "requireAuth": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "locales": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "actions": {
                  "type": "object",
                  "patternProperties": {
                    "^(.*)$": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "additionalProperties": false
    },
    "APIAuth": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "none"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "in",
            "name"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "apiKey"
            },
            "in": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "header"
                },
                {
                  "type": "string",
                  "const": "query"
                }
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "scheme"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "http"
            },
            "scheme": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "basic"
                },
                {
                  "type": "string",
                  "const": "bearer"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "flow",
            "authorizationURL",
            "tokenURL",
            "clientID",
            "redirectURI",
            "scopes",
            "pkce"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "oauth2"
            },
            "flow": {
              "type": "string",
              "const": "authorizationCode"
            },
            "authorizationURL": {
              "type": "string"
            },
            "tokenURL": {
              "type": "string"
            },
            "clientID": {
              "type": "string",
              "minLength": 1
            },
            "redirectURI": {
              "type": "string"
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "pkce": {
              "type": "string",
              "const": "S256"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "IOSCatalogManifest": {
      "type": "object",
      "required": [
        "domain",
        "name",
        "supportedIOS",
        "actions"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^ios:[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "icon": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "asset"
              ],
              "properties": {
                "asset": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "system"
              ],
              "properties": {
                "system": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "faviconUrl": {
          "type": "string",
          "minLength": 1
        },
        "permission": {
          "anyOf": [
            {
              "type": "string",
              "const": "bluetooth"
            },
            {
              "type": "string",
              "const": "calendar"
            },
            {
              "type": "string",
              "const": "contacts"
            },
            {
              "type": "string",
              "const": "health"
            },
            {
              "type": "string",
              "const": "location"
            },
            {
              "type": "string",
              "const": "notifications"
            },
            {
              "type": "string",
              "const": "reminders"
            }
          ]
        },
        "supportedIOS": {
          "type": "object",
          "required": [
            "minimum"
          ],
          "properties": {
            "minimum": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]*)(?:\\.[0-9]+){0,2}$"
            },
            "maximum": {
              "type": "string",
              "pattern": "^(?:[1-9][0-9]*)(?:\\.[0-9]+){0,2}$"
            }
          },
          "additionalProperties": false
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "inputSchema",
              "outputSchema",
              "requireApproval",
              "requireAuth"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "inputSchema": {
                "type": "object",
                "properties": {},
                "additionalProperties": true
              },
              "outputSchema": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "requireApproval": {
                "type": "boolean"
              },
              "requireAuth": {
                "type": "boolean",
                "const": false
              }
            },
            "additionalProperties": false
          }
        },
        "locales": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "actions": {
                  "type": "object",
                  "patternProperties": {
                    "^(.*)$": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "additionalProperties": false
    },
    "MCPCatalogManifest": {
      "type": "object",
      "required": [
        "id",
        "name",
        "endpoint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "faviconUrl": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "anyOf": [
            {
              "type": "string",
              "const": "streamable-http"
            },
            {
              "type": "string",
              "const": "sse"
            }
          ]
        },
        "locales": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
