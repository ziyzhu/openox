{
  "ox.schedule.create": {"description": "Schedule a frozen snapshot of one resolved skill package after explicit user confirmation: `await ox.schedule.create({ purpose, skill, argument?, frequency, fireAt?, hour?, minute?, weekday?, timeZone? })`. Use `fireAt` for `once`; use `hour` and `minute` for `daily`; add a weekday name for `weekly`. Times are best-effort on iOS.", "inputSchema": {"additionalProperties": false, "properties": {"argument": {"maxLength": 10000, "minLength": 0, "type": "string"}, "fireAt": {"maxLength": 500, "minLength": 1, "type": "string"}, "frequency": {"enum": ["once", "daily", "weekly"], "type": "string"}, "hour": {"maximum": 23, "minimum": 0, "type": "integer"}, "minute": {"maximum": 59, "minimum": 0, "type": "integer"}, "purpose": {"description": "Short (<10 words) description shown to the user as the step label.", "maxLength": 80, "minLength": 1, "type": "string"}, "skill": {"maxLength": 500, "minLength": 1, "type": "string"}, "timeZone": {"maxLength": 500, "minLength": 1, "type": "string"}, "weekday": {"enum": ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"], "type": "string"}}, "required": ["purpose", "skill", "frequency"], "type": "object"}, "outputSchema": {"additionalProperties": false, "properties": {"argument": {"maxLength": 10000, "minLength": 0, "type": "string"}, "enabled": {"type": "boolean"}, "id": {"maxLength": 64, "minLength": 1, "type": "string"}, "lastChatId": {"maxLength": 64, "minLength": 1, "type": "string"}, "lastError": {"maxLength": 500, "minLength": 1, "type": "string"}, "lastOutcome": {"enum": ["succeeded", "cancelled", "failed"], "type": "string"}, "lastRunAt": {"maxLength": 500, "minLength": 1, "type": "string"}, "nextFireAt": {"maxLength": 500, "minLength": 1, "type": "string"}, "recurrence": {"maxLength": 500, "minLength": 1, "type": "string"}, "skill": {"maxLength": 500, "minLength": 1, "type": "string"}}, "required": ["id", "skill", "argument", "enabled", "recurrence"], "type": "object"}},
