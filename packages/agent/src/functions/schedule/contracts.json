{
  "ox.schedule.create": {"description": "Create a persistent prompt schedule: `await ox.schedule.create({ purpose, name, prompt, frequency, fireAt?, intervalSeconds?, hour?, minute?, weekday?, timeZone?, condition?, deadline?, conversation?, services? })`. Use a future ISO-8601 fireAt for once; intervalSeconds (at least 30) for interval; hour/minute for daily; add weekday for weekly. A condition is a natural-language stop condition checked by the agent on every run; it requires a recurring frequency and a future ISO-8601 deadline. Include the final action in prompt. Choose conversation current for a follow-up using this conversation's context, or new for independent runs (default). Attach needed service domains with services. To run a skill, write a prompt asking to use that skill. Execution survives app restarts; iOS background timing is best-effort, not an exact interval guarantee. Service calls retain their normal Action policies.", "inputSchema": {"additionalProperties": false, "properties": {"fireAt": {"maxLength": 500, "minLength": 1, "type": "string"}, "frequency": {"enum": ["once", "interval", "daily", "weekly"], "type": "string"}, "hour": {"maximum": 23, "minimum": 0, "type": "integer"}, "minute": {"maximum": 59, "minimum": 0, "type": "integer"}, "purpose": {"description": "Short (<10 words) description shown to the user as the step label.", "maxLength": 80, "minLength": 1, "type": "string"}, "timeZone": {"maxLength": 500, "minLength": 1, "type": "string"}, "weekday": {"enum": ["sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday"], "type": "string"}, "name": {"maxLength": 500, "minLength": 1, "type": "string"}, "prompt": {"type": "string", "minLength": 0, "maxLength": 10000}, "condition": {"type": "string", "minLength": 0, "maxLength": 10000}, "deadline": {"maxLength": 500, "minLength": 1, "type": "string"}, "conversation": {"type": "string", "enum": ["current", "new"]}, "services": {"type": "array", "items": {"maxLength": 500, "minLength": 1, "type": "string"}, "maxItems": 100}, "intervalSeconds": {"type": "integer", "minimum": 30, "maximum": 31536000}}, "required": ["purpose", "name", "prompt", "frequency"], "type": "object"}, "outputSchema": {"additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "id": {"maxLength": 64, "minLength": 1, "type": "string"}, "lastConversationId": {"maxLength": 64, "minLength": 1, "type": "string"}, "lastError": {"maxLength": 500, "minLength": 1, "type": "string"}, "lastOutcome": {"enum": ["succeeded", "cancelled", "failed"], "type": "string"}, "lastRunAt": {"maxLength": 500, "minLength": 1, "type": "string"}, "nextFireAt": {"maxLength": 500, "minLength": 1, "type": "string"}, "recurrence": {"maxLength": 500, "minLength": 1, "type": "string"}, "name": {"maxLength": 500, "minLength": 1, "type": "string"}, "prompt": {"type": "string", "minLength": 0, "maxLength": 10000}, "condition": {"type": "string", "minLength": 0, "maxLength": 10000}, "deadline": {"maxLength": 500, "minLength": 1, "type": "string"}, "conversationId": {"maxLength": 64, "minLength": 1, "type": "string"}, "status": {"type": "string", "enum": ["active", "running", "paused", "completed", "expired"]}}, "required": ["id", "name", "prompt", "status", "enabled", "recurrence"], "type": "object"}},
  "ox.schedule.delete": {"description": "Delete a schedule and cancel any active check using the user's Action policy: `await ox.schedule.delete({ purpose, id })`.", "inputSchema": {"additionalProperties": false, "properties": {"id": {"maxLength": 64, "minLength": 1, "type": "string"}, "purpose": {"description": "Short (<10 words) description shown to the user as the step label.", "maxLength": 80, "minLength": 1, "type": "string"}}, "required": ["purpose", "id"], "type": "object"}, "outputSchema": {"additionalProperties": false, "properties": {"deleted": {"type": "boolean"}, "id": {"maxLength": 64, "minLength": 1, "type": "string"}}, "required": ["id", "deleted"], "type": "object"}},
  "ox.schedule.enable": {"description": "Pause or resume a schedule: `await ox.schedule.enable({ purpose, id, enabled })`. Pausing cancels its active check. Resume does not replay missed checks. An expired deadline must be edited before resuming.", "inputSchema": {"additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "id": {"maxLength": 64, "minLength": 1, "type": "string"}, "purpose": {"description": "Short (<10 words) description shown to the user as the step label.", "maxLength": 80, "minLength": 1, "type": "string"}}, "required": ["purpose", "id", "enabled"], "type": "object"}, "outputSchema": {"additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "id": {"maxLength": 64, "minLength": 1, "type": "string"}, "lastConversationId": {"maxLength": 64, "minLength": 1, "type": "string"}, "lastError": {"maxLength": 500, "minLength": 1, "type": "string"}, "lastOutcome": {"enum": ["succeeded", "cancelled", "failed"], "type": "string"}, "lastRunAt": {"maxLength": 500, "minLength": 1, "type": "string"}, "nextFireAt": {"maxLength": 500, "minLength": 1, "type": "string"}, "recurrence": {"maxLength": 500, "minLength": 1, "type": "string"}, "name": {"maxLength": 500, "minLength": 1, "type": "string"}, "prompt": {"type": "string", "minLength": 0, "maxLength": 10000}, "condition": {"type": "string", "minLength": 0, "maxLength": 10000}, "deadline": {"maxLength": 500, "minLength": 1, "type": "string"}, "conversationId": {"maxLength": 64, "minLength": 1, "type": "string"}, "status": {"type": "string", "enum": ["active", "running", "paused", "completed", "expired"]}}, "required": ["id", "name", "prompt", "status", "enabled", "recurrence"], "type": "object"}},
  "ox.schedule.list": {"description": "List persistent prompt schedules and their state in the active Profile: `await ox.schedule.list({ purpose })`.", "inputSchema": {"additionalProperties": false, "properties": {"purpose": {"description": "Short (<10 words) description shown to the user as the step label.", "maxLength": 80, "minLength": 1, "type": "string"}}, "required": ["purpose"], "type": "object"}, "outputSchema": {"items": {"additionalProperties": false, "properties": {"enabled": {"type": "boolean"}, "id": {"maxLength": 64, "minLength": 1, "type": "string"}, "lastConversationId": {"maxLength": 64, "minLength": 1, "type": "string"}, "lastError": {"maxLength": 500, "minLength": 1, "type": "string"}, "lastOutcome": {"enum": ["succeeded", "cancelled", "failed"], "type": "string"}, "lastRunAt": {"maxLength": 500, "minLength": 1, "type": "string"}, "nextFireAt": {"maxLength": 500, "minLength": 1, "type": "string"}, "recurrence": {"maxLength": 500, "minLength": 1, "type": "string"}, "name": {"maxLength": 500, "minLength": 1, "type": "string"}, "prompt": {"type": "string", "minLength": 0, "maxLength": 10000}, "condition": {"type": "string", "minLength": 0, "maxLength": 10000}, "deadline": {"maxLength": 500, "minLength": 1, "type": "string"}, "conversationId": {"maxLength": 64, "minLength": 1, "type": "string"}, "status": {"type": "string", "enum": ["active", "running", "paused", "completed", "expired"]}}, "required": ["id", "name", "prompt", "status", "enabled", "recurrence"], "type": "object"}, "type": "array"}},
  "ox.schedule.run": {"description": "Request one check now: `await ox.schedule.run({ purpose, id })`. A running check cannot overlap itself; expired deadlines are enforced.", "inputSchema": {"additionalProperties": false, "properties": {"id": {"maxLength": 64, "minLength": 1, "type": "string"}, "purpose": {"description": "Short (<10 words) description shown to the user as the step label.", "maxLength": 80, "minLength": 1, "type": "string"}}, "required": ["purpose", "id"], "type": "object"}, "outputSchema": {"additionalProperties": false, "properties": {"id": {"maxLength": 64, "minLength": 1, "type": "string"}, "started": {"type": "boolean"}}, "required": ["id", "started"], "type": "object"}},
  "ox.schedule.complete": {"description": "Mark the current scheduled condition check complete: `await ox.schedule.complete({ purpose })`. Call only after the stop condition is true and the requested final action succeeds. Only an active scheduled run can complete its own schedule; user text and ordinary conversations cannot complete other schedules. If the condition is false, simply finish the check without calling complete. Do not sleep or implement a polling loop inside a run.", "inputSchema": {"type": "object", "properties": {"purpose": {"description": "Short (<10 words) description shown to the user as the step label.", "maxLength": 80, "minLength": 1, "type": "string"}}, "additionalProperties": false, "required": ["purpose"]}, "outputSchema": {"type": "object", "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 64}, "completed": {"type": "boolean"}}, "additionalProperties": false, "required": ["id", "completed"]}}
}
