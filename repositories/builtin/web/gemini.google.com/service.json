{
  "domain": "gemini.google.com",
  "name": "Gemini",
  "description": "Search saved Gemini chats, open search results and recent conversations, read messages, and chat with approval.",
  "baseUrl": "https://gemini.google.com/app",
  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in to Gemini",
      "description": "Open Gemini to sign in with Google.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "getSignInState",
      "label": "Check Gemini sign-in",
      "description": "Check a fresh server response for an authenticated session.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "getCurrentConversation",
      "label": "Read Gemini conversation",
      "description": "Read up to 100 currently rendered messages. Not full-history pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "rendered"
            ]
          }
        },
        "required": [
          "conversationId",
          "url",
          "messages",
          "scope"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "openConversation",
      "label": "Open Gemini conversation",
      "description": "Open an exact conversation ID from the loaded recent sidebar and read rendered messages.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^[a-f0-9]{8,64}$"
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "rendered"
            ]
          }
        },
        "required": [
          "conversationId",
          "url",
          "messages",
          "scope"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "listWebsiteModels",
      "label": "List Gemini modes",
      "description": "Read the current finite model/mode picker; does not change selection.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "chat",
      "label": "Start Gemini chat",
      "description": "Start a new text conversation and submit once. Returns confirmed submission or uncertainty; replies may still be generating.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "submissionConfirmed": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "unconfirmed"
            ]
          },
          "reply": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "conversationId",
          "url",
          "submissionConfirmed",
          "status",
          "reply"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "continueChat",
      "label": "Continue Gemini chat",
      "description": "Open a chat from the loaded sidebar and submit one follow-up. Does not retry uncertain submissions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^[a-f0-9]{8,64}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          }
        },
        "required": [
          "conversationId",
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "submissionConfirmed": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "unconfirmed"
            ]
          },
          "reply": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "conversationId",
          "url",
          "submissionConfirmed",
          "status",
          "reply"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "searchConversations",
      "label": "Search saved chats",
      "description": "Search saved chats through Gemini native search with source continuation cursors. Continue the same query on this service page; search state resets on reload. Keeps up to 12 captured pages. Open returned results with openSearchConversation. Uses native matching and ranking, not guaranteed literal substring matching; terminal and empty-result behavior remain unverified.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "openSearchConversation",
      "label": "Open search result",
      "description": "Open and read a conversation ID returned by the current search session, including chats absent from the sidebar.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^[a-f0-9]{8,64}$"
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "rendered"
            ]
          }
        },
        "required": [
          "conversationId",
          "url",
          "messages",
          "scope"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "listModels",
      "label": "List provider models",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "input": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "text",
                      "image",
                      "pdf"
                    ]
                  }
                },
                "contextTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "outputTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "streaming": {
                  "type": "boolean"
                },
                "cancellation": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "temperature",
                      "maxTokens"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "name",
                "input",
                "contextTokens",
                "outputTokens",
                "streaming",
                "cancellation",
                "options"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "models"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://gemini.google.com/app"
    },
    {
      "id": "startModelGeneration",
      "label": "Start model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant",
                    "tool"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "mimeType"
              ],
              "additionalProperties": false
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "temperature": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "temperature",
              "maxTokens"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "modelId",
          "messages",
          "attachments",
          "options"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          },
          "submission": {
            "type": "string",
            "enum": [
              "uncertain",
              "confirmed"
            ]
          }
        },
        "required": [
          "generationId",
          "submission"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "baseUrl": "https://gemini.google.com/app"
    },
    {
      "id": "readModelGeneration",
      "label": "Read model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          },
          "after": {
            "type": "integer",
            "minimum": 0
          },
          "waitMilliseconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "generationId",
          "after",
          "waitMilliseconds"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "completed"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "failed"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "contextOverflow",
                        "rateLimited",
                        "network",
                        "authentication",
                        "unsupportedInput",
                        "provider"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "message",
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "nextCursor",
          "events"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://gemini.google.com/app"
    },
    {
      "id": "cancelModelGeneration",
      "label": "Cancel model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          }
        },
        "required": [
          "generationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "cancelled",
              "requested",
              "completed",
              "unsupported"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "baseUrl": "https://gemini.google.com/app"
    }
  ]
}
