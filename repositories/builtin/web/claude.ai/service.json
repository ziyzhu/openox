{
  "domain": "claude.ai",
  "name": "Claude",
  "description": "Chat with Claude using your signed-in website account, read paginated conversation history, and choose a model. Sending messages requires approval. Continuing chats requires a loaded sidebar entry.",
  "baseUrl": "https://claude.ai/robots.txt",
  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in to Claude",
      "description": "Open Claude sign-in.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "getSignInState",
      "label": "Check sign-in",
      "description": "Check the current Claude session with a fresh server request.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "getCurrentUser",
      "label": "Get account",
      "description": "Read basic account information and available organizations.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "organizations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "organizations"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "listConversations",
      "label": "List conversations",
      "description": "List unarchived conversations using source offset pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "description": "Organization ID from getCurrentUser. Omit only when the account has one organization."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 20
          },
          "cursor": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "title",
                "model",
                "url",
                "updatedAt"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "getConversation",
      "label": "Read conversation",
      "description": "Read message text from a conversation. Parent IDs preserve branch relationships; tool and attachment contents are excluded.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "description": "Organization ID from getCurrentUser. Omit only when the account has one organization."
          },
          "conversationId": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$"
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "parentId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "createdAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "parentId",
                "role",
                "text",
                "createdAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "model",
          "url",
          "messages"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "listModels",
      "label": "List models",
      "description": "List selectable models currently exposed by the new-chat picker. Credit-purchase options and effort controls are excluded.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "selected": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "selected"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://claude.ai/new"
    },
    {
      "id": "selectModel",
      "label": "Select model",
      "description": "Select a model for new chats; does not buy credits or send a message.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "selected": {
            "type": "string"
          }
        },
        "required": [
          "selected"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "baseUrl": "https://claude.ai/new"
    },
    {
      "id": "chat",
      "label": "Start chat",
      "description": "Send one text message in a new chat. Refuses to overwrite an existing draft. A pending result must be checked with getConversation, not resent. Submission outcomes are confirmed against new server message IDs. Pending or unconfirmed outcomes must be read before any retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          },
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "description": "Organization ID from getCurrentUser. Omit only when the account has one organization."
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "response_available",
              "submitted_pending",
              "submission_unconfirmed"
            ]
          },
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "response": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "conversationId",
          "url",
          "response"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "baseUrl": "https://claude.ai/new"
    },
    {
      "id": "continueChat",
      "label": "Continue chat",
      "description": "Send one text message to an exact conversation loaded in the sidebar. Refuses existing drafts and does not retry submissions. Submission outcomes are confirmed against new server message IDs. Pending or unconfirmed outcomes must be read before any retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^[a-f0-9-]{36}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          },
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "description": "Organization ID from getCurrentUser. Omit only when the account has one organization."
          }
        },
        "required": [
          "conversationId",
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "response_available",
              "submitted_pending",
              "submission_unconfirmed"
            ]
          },
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "response": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "conversationId",
          "url",
          "response"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "baseUrl": "https://claude.ai/new"
    },
    {
      "id": "searchConversations",
      "label": "Search conversations",
      "description": "Return up to 25 source-ranked conversation matches. Search may include semantic matches. Nonterminal source pagination is not yet supported.",
      "requireAuth": true,
      "requireApproval": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "description": "Organization ID from getCurrentUser. Omit only when the account has one organization."
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "title",
                "model",
                "url",
                "updatedAt"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "degraded": {
            "type": "boolean"
          },
          "mode": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "degraded",
          "mode"
        ],
        "additionalProperties": false
      }
    }
  ]
}
