{
  "domain": "muse.ai",
  "name": "Muse",
  "description": "Search saved Muse chat-message excerpts, read the current conversation, and send messages with approval.",
  "baseUrl": "https://muse.ai/",
  "faviconUrl": "https://t1.gstatic.com/faviconV2?client=SOCIAL&type=FAVICON&fallback_opts=TYPE,SIZE,URL&url=https://muse.ai&size=128",
  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in to Muse",
      "description": "Open Muse to sign in.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "getSignInState",
      "label": "Check Muse sign-in",
      "description": "Check the current server session.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "getCurrentConversation",
      "label": "Read current conversation",
      "description": "Read currently rendered messages, not full conversation history.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 30
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "rendered"
            ]
          },
          "pending": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "messages",
          "scope",
          "pending"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "chat",
      "label": "Chat with Muse",
      "description": "Send one message in the current Muse conversation. Muse may take actions in response; this is not restricted to text generation. Never automatically retry an uncertain submission.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "submitted": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "replied",
              "pending"
            ]
          },
          "reply": {
            "type": [
              "string",
              "null"
            ]
          },
          "conversation": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "role",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "scope": {
                "type": "string",
                "enum": [
                  "rendered"
                ]
              },
              "pending": {
                "type": "boolean"
              }
            },
            "required": [
              "url",
              "messages",
              "scope",
              "pending"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "submitted",
          "status",
          "reply",
          "conversation"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "continueChat",
      "label": "Continue Muse chat",
      "description": "Send one message in the current Muse conversation. Muse may take actions in response; this is not restricted to text generation. Never automatically retry an uncertain submission.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "submitted": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "replied",
              "pending"
            ]
          },
          "reply": {
            "type": [
              "string",
              "null"
            ]
          },
          "conversation": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "role",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "scope": {
                "type": "string",
                "enum": [
                  "rendered"
                ]
              },
              "pending": {
                "type": "boolean"
              }
            },
            "required": [
              "url",
              "messages",
              "scope",
              "pending"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "submitted",
          "status",
          "reply",
          "conversation"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "searchConversations",
      "label": "Search saved chats",
      "description": "Search Muse native command-palette chat-message matches and return excerpts. This is a bounded native result set, not exhaustive history; no source continuation or reliable result opening is exposed. complete is always false. Preserves unsent drafts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "excerpt": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "excerpt"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          },
          "scope": {
            "type": "string",
            "enum": [
              "native-palette-chat-messages"
            ]
          },
          "complete": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        },
        "required": [
          "items",
          "nextCursor",
          "scope",
          "complete"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    }
  ]
}
