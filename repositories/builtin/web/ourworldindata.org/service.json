{
  "domain": "ourworldindata.org",
  "name": "Our World in Data",
  "description": "Research on the world's largest problems. Covers global development, health, energy, population, and more. Search articles and topic pages, search the chart catalog, browse the latest publications, and read the data behind any chart (latest values across countries, units, and sources).",
  "baseUrl": "https://ourworldindata.org/",
  "$defs": {
    "page": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "title",
        "slug",
        "url"
      ],
      "additionalProperties": false
    },
    "chart": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ]
        },
        "variantName": {
          "type": [
            "string",
            "null"
          ]
        },
        "slug": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "availableEntities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "title",
        "slug",
        "url"
      ],
      "additionalProperties": false
    }
  },
  "actions": [
    {
      "id": "search",
      "label": "Search articles & topics",
      "description": "Full-text search across articles, topic pages, and data insights.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/page"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "searchCharts",
      "label": "Search charts",
      "description": "Search the catalog of charts and explorer views by topic or country.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/chart"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "listLatest",
      "label": "Latest publications",
      "description": "Most recent articles, data insights, and announcements.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/page"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getChartData",
      "label": "Read chart data",
      "description": "Fetch the data behind a chart by its grapher slug: latest value, unit, source, and a table of values across countries/regions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "entities": {
            "type": "string",
            "description": "Optional ISO3 entity code (e.g. CHN) to focus the chart on."
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "latest": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "entity": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "time": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "entity",
              "value",
              "time"
            ],
            "additionalProperties": false
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "time": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "entity",
                "value",
                "time"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "slug",
          "title",
          "rows"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    }
  ]
}
