          "complete": {
            "type": "boolean"
          }
        },
        "required": [
          "items",
          "complete"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "openDot",
      "label": "Open dot",
      "description": "Open a Dot thread returned by List dots. The Dot must still belong to the current signed-in account.",
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true,
      "baseUrl": "https://chatgpt.com/dots/home",
      "inputSchema": {
        "type": "object",
