                  "type": [
                    "string",
                    "null"
                  ]
                },
                "threadRef": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "status",
                "threadRef",
                "url"
