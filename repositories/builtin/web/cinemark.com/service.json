{
  "domain": "cinemark.com",
  "name": "Cinemark",
  "description": "Find nearby Cinemark theaters and official movie dates and showtimes.",
  "baseUrl": "https://www.cinemark.com/",
  "faviconUrl": "https://www.cinemark.com/images/favicons/apple-touch-icon-152x152.png",
  "actions": [
    {
      "id": "findTheatres",
      "label": "Find Theatres",
      "description": "List Cinemark theaters near a ZIP code.",
      "baseUrl": "https://www.cinemark.com/theatres/",
      "requireAuth": false,
      "requireApproval": false,
      "defaultArgs": {
        "zipCode": "98101",
        "query": "Lincoln Square",
        "limit": 10
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "zipCode": {
            "type": "string",
            "pattern": "^\\d{5}$"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 10
          }
        },
        "required": [
          "zipCode"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "theaterId": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "cityState": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "distance": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "theaterId",
                "name",
                "cityState",
                "distance",
                "url"
              ]
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      }
    },
    {
      "id": "getMovie",
      "label": "Get Movie",
      "description": "Resolve a Cinemark movie page to its official movie ID and title.",
      "baseUrl": "https://www.cinemark.com/movies/dear-you-teochew-with-chinese-and-english-subtitles",
      "requireAuth": false,
      "requireApproval": false,
      "defaultArgs": {
        "movieSlug": "dear-you-teochew-with-chinese-and-english-subtitles"
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "movieSlug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "movieSlug"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "movieId": {
            "type": "integer"
          },
          "contentId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "movieSlug": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "movieId",
          "contentId",
          "title",
          "movieSlug",
          "url"
        ]
      }
    },
    {
      "id": "listMovieDates",
      "label": "List Movie Dates",
      "description": "List dates Cinemark publishes for a movie at selected theaters.",
      "requireAuth": false,
      "requireApproval": false,
      "defaultArgs": {
        "movieId": 110766,
        "theaterIds": [
          1118
        ],
        "currentTheaterId": 1118
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "movieId": {
            "type": "integer",
            "minimum": 1
          },
          "theaterIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "currentTheaterId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "movieId",
          "theaterIds",
          "currentTheaterId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "sourceUrl": {
            "type": "string"
          }
        },
        "required": [
          "dates",
          "sourceUrl"
        ]
      }
    },
    {
      "id": "listMovieShowtimes",
      "label": "List Movie Showtimes",
      "description": "List official Cinemark showtimes with ticket links.",
      "requireAuth": false,
      "requireApproval": false,
      "defaultArgs": {
        "movieId": 110766,
        "date": "2026-09-19",
        "theaterIds": [
          1118
        ],
        "currentTheaterId": 1118,
        "expandSearch": false
      },
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "movieId": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "theaterIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "currentTheaterId": {
            "type": "integer",
            "minimum": 1
          },
          "expandSearch": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "movieId",
          "date",
          "theaterIds",
          "currentTheaterId"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "theaterId": {
                  "type": "integer"
                },
                "theaterName": {
                  "type": "string"
                },
                "cityState": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "showtimeId": {
                  "type": "integer"
                },
                "time": {
                  "type": "string"
                },
                "showtimeLocal": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "format": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ticketUrl": {
                  "type": "string"
                }
              },
              "required": [
                "theaterId",
                "theaterName",
                "cityState",
                "showtimeId",
                "time",
                "showtimeLocal",
                "format",
                "ticketUrl"
              ]
            }
          },
          "sourceUrl": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "sourceUrl"
        ]
      }
    }
  ]
}
