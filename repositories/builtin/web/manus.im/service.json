    {
      "id": "getTask",
      "label": "Read task",
      "description": "Read a Manus task by URL ID using server-backed history, including complete user/assistant text and available attachment or generated-file metadata.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "taskId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed",
              "unknown"
            ]
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/file"
                  }
                }
              },
              "required": [
                "id",
                "role",
                "text",
                "files"
              ],
              "additionalProperties": false
            }
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/file"
            }
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "status",
          "messages",
          "files"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://manus.im/app",
      "blocking": true
    },
    {
      "id": "getTaskFiles",
      "label": "Get task files",
      "description": "Read available attachment and generated-file metadata for a Manus task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "taskId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/file"
            }
          }
        },
        "required": [
          "taskId",
          "url",
          "files"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://manus.im/app",
      "blocking": true
    },
    {
      "id": "listCreations",
      "label": "List creations",
      "description": "List and search the Manus Creations library, including websites, mobile apps, games, and legacy artifacts, with native page-token pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "default": ""
          },
          "category": {
            "type": "string",
            "enum": [
              "all",
              "website",
              "mobile_app",
              "game"
            ],
            "default": "all"
          },
          "pageToken": {
            "type": "string",
            "default": ""
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/libraryItem"
            }
          },
          "nextPageToken": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextPageToken"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://manus.im/app"
    },
    {
      "id": "listDocuments",
      "label": "List documents",
      "description": "List and search the Manus Documents library with file-type, favorites, and source-offset filters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "default": ""
          },
          "type": {
            "type": "string",
            "enum": [
              "all",
              "websites",
              "documents",
              "media",
              "audio",
              "slides",
              "tables",
              "images",
              "audio_video",
              "web_apps",
              "games",
              "videos",
              "others"
            ],
            "default": "all"
          },
          "favoritesOnly": {
            "type": "boolean",
            "default": false
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/libraryItem"
            }
          },
          "totalFiles": {
            "type": "integer",
            "minimum": 0
          },
          "totalSessions": {
            "type": "integer",
            "minimum": 0
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextOffset": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "totalFiles",
          "totalSessions",
          "hasMore",
          "nextOffset"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://manus.im/app"
    },
    {
      "id": "chat",
      "label": "Start task",
      "description": "Start one text task in Manus. A pending or unconfirmed result must be read before any retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "response_available",
              "submitted_pending",
              "submission_unconfirmed"
            ]
          },
          "taskId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "response": {
            "type": [
              "string",
              "null"
            ]
          },
          "responseFiles": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/file"
            }
          }
        },
        "required": [
          "status",
          "taskId",
          "url",
          "response",
          "responseFiles"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "baseUrl": "https://manus.im/app",
      "blocking": true
    },
    {
      "id": "continueTask",
      "label": "Continue task",
      "description": "Send one follow-up to a Manus task by its URL ID. A pending or unconfirmed result must be read before any retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          }
        },
        "required": [
          "taskId",
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "response_available",
              "submitted_pending",
              "submission_unconfirmed"
            ]
          },
          "taskId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "response": {
            "type": [
              "string",
              "null"
            ]
          },
          "responseFiles": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/file"
            }
          }
        },
        "required": [
          "status",
          "taskId",
          "url",
          "response",
          "responseFiles"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "baseUrl": "https://manus.im/app",
      "blocking": true
    },
    {
      "id": "listModels",
      "label": "List Manus models",
      "description": "List the Manus website model available to Ox.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "input": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "text",
                      "image",
                      "pdf"
                    ]
                  }
                },
                "contextTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "outputTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "streaming": {
                  "type": "boolean"
                },
                "cancellation": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "temperature",
                      "maxTokens"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "name",
                "input",
                "contextTokens",
                "outputTokens",
                "streaming",
                "cancellation",
                "options"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "models"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://manus.im/app"
    },
    {
      "id": "startModelGeneration",
      "label": "Start Manus generation",
      "description": "Start a fresh Manus task from the complete Ox conversation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant",
                    "tool"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "mimeType"
              ],
              "additionalProperties": false
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "temperature": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "temperature",
              "maxTokens"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "modelId",
          "messages",
          "attachments",
          "options"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          },
          "submission": {
            "type": "string",
            "enum": [
              "uncertain",
              "confirmed"
            ]
          }
        },
        "required": [
          "generationId",
          "submission"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://manus.im/app"
    },
    {
      "id": "readModelGeneration",
      "label": "Read Manus generation",
      "description": "Read the final Manus response and terminal status.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          },
          "after": {
            "type": "integer",
            "minimum": 0
          },
          "waitMilliseconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "generationId",
          "after",
          "waitMilliseconds"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "completed"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "failed"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "contextOverflow",
                        "rateLimited",
                        "network",
                        "authentication",
                        "unsupportedInput",
                        "provider"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "message",
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "nextCursor",
          "events"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://manus.im/app"
    },
    {
      "id": "cancelModelGeneration",
      "label": "Cancel Manus generation",
      "description": "Report whether the Manus generation can be cancelled.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          }
        },
        "required": [
          "generationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "cancelled",
              "requested",
              "completed",
              "unsupported"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "baseUrl": "https://manus.im/app"
    }
  ],
