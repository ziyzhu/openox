{
  "domain": "qwen.ai",
  "name": "Qwen",
  "description": "Chat with Qwen, search and read saved conversations, browse history and models, and select a model. Sending requires approval. Opening and continuing require a loaded sidebar entry.",
  "baseUrl": "https://chat.qwen.ai/",
  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in",
      "description": "Open Qwen sign-in.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "getSignInState",
      "label": "Check sign-in",
      "description": "Check a fresh page-owned server identity response.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "getCurrentUser",
      "label": "Get account",
      "description": "Read basic signed-in account information.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "listWebsiteModels",
      "label": "List models",
      "description": "Read available catalog model names; not all are exposed in the picker.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "listConversations",
      "label": "List saved chats",
      "description": "Read source-numbered pages. An empty page ends pagination.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,5}$"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "chat",
      "label": "Start chat",
      "description": "Start a new text chat and wait briefly for the reply. Never automatically retries an uncertain submission.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "submissionConfirmed": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "pending",
              "uncertain"
            ]
          },
          "conversation": {
            "anyOf": [
              {
                "$ref": "#/$defs/conversation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "submissionConfirmed",
          "status",
          "conversation"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "getConversation",
      "label": "Read conversation",
      "description": "Read up to 100 messages from the server-returned history window.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$"
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/conversation"
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "openConversation",
      "label": "Open saved chat",
      "description": "Open an exact, uniquely titled chat from the loaded sidebar. Older unloaded chats are unsupported.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$"
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/conversation"
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "continueChat",
      "label": "Continue chat",
      "description": "Open the selected sidebar chat and send one message with fresh server confirmation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "pattern": "^[0-9a-f-]{36}$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "required": [
          "conversationId",
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "submissionConfirmed": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "pending",
              "uncertain"
            ]
          },
          "conversation": {
            "anyOf": [
              {
                "$ref": "#/$defs/conversation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "submissionConfirmed",
          "status",
          "conversation"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "selectModel",
      "label": "Select model",
      "description": "Choose a model available in the current website picker without sending a message.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "selected": {
            "type": "string"
          }
        },
        "required": [
          "selected"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "searchConversations",
      "label": "Search saved chats",
      "description": "Search saved conversations using Qwen history search. Continue with the same query and returned page cursor until an empty terminal page. Read results by ID with getConversation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "cursor": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "listModels",
      "label": "List provider models",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "input": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "text",
                      "image",
                      "pdf"
                    ]
                  }
                },
                "contextTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "outputTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "streaming": {
                  "type": "boolean"
                },
                "cancellation": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "temperature",
                      "maxTokens"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "name",
                "input",
                "contextTokens",
                "outputTokens",
                "streaming",
                "cancellation",
                "options"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "models"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "startModelGeneration",
      "label": "Start model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant",
                    "tool"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "mimeType"
              ],
              "additionalProperties": false
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "temperature": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "temperature",
              "maxTokens"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "modelId",
          "messages",
          "attachments",
          "options"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          },
          "submission": {
            "type": "string",
            "enum": [
              "uncertain",
              "confirmed"
            ]
          }
        },
        "required": [
          "generationId",
          "submission"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true
    },
    {
      "id": "readModelGeneration",
      "label": "Read model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          },
          "after": {
            "type": "integer",
            "minimum": 0
          },
          "waitMilliseconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "generationId",
          "after",
          "waitMilliseconds"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "completed"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "failed"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "contextOverflow",
                        "rateLimited",
                        "network",
                        "authentication",
                        "unsupportedInput",
                        "provider"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "message",
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "nextCursor",
          "events"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "cancelModelGeneration",
      "label": "Cancel model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          }
        },
        "required": [
          "generationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "cancelled",
              "requested",
              "completed",
              "unsupported"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true
    }
  ],
  "$defs": {
    "conversation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "done": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "role",
              "text",
              "done"
            ],
            "additionalProperties": false
          }
        },
        "hasEarlierMessages": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "messages",
        "hasEarlierMessages"
      ],
      "additionalProperties": false
    }
  }
}
