{
  "domain": "blueprint.bryanjohnson.com",
  "name": "Blueprint",
  "description": "Bryan Johnson's health and longevity store. Search products, browse Bryan's favorites, inspect variants, view the cart, and add an item without placing an order.",
  "baseUrl": "https://blueprint.bryanjohnson.com/cart.js",
  "$defs": {
    "productSummary": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "handle": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "productUrl": { "type": "string" },
        "image": { "type": "string" },
        "price": { "type": "number" },
        "available": { "type": "boolean" }
      },
      "required": ["id", "handle", "name", "description", "productUrl", "image", "price", "available"],
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "available": { "type": ["boolean", "null"] },
        "image": { "type": "string" },
        "weight": { "type": ["number", "null"] },
        "weightUnit": { "type": ["string", "null"] }
      },
      "required": ["id", "productId", "name", "sku", "price", "currency", "available", "image", "weight", "weightUnit"],
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "handle": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "productUrl": { "type": "string" },
        "image": { "type": "string" },
        "price": { "type": "number" },
        "available": { "type": "boolean" },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/variant" }
        }
      },
      "required": ["id", "handle", "name", "description", "productUrl", "image", "price", "available", "variants"],
      "additionalProperties": false
    },
    "cartItem": {
      "type": "object",
      "properties": {
        "variantId": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "variantName": { "type": "string" },
        "sku": { "type": "string" },
        "quantity": { "type": "integer" },
        "unitPrice": { "type": "number" },
        "total": { "type": "number" },
        "currency": { "type": "string" },
        "image": { "type": "string" },
        "productUrl": { "type": "string" },
        "sellingPlanId": { "type": ["string", "null"] }
      },
      "required": ["variantId", "productId", "name", "variantName", "sku", "quantity", "unitPrice", "total", "currency", "image", "productUrl", "sellingPlanId"],
      "additionalProperties": false
    },
    "cart": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/cartItem" }
        },
        "itemCount": { "type": "integer" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "currency": { "type": "string" }
      },
      "required": ["items", "itemCount", "subtotal", "total", "currency"],
      "additionalProperties": false
    }
  },
  "actions": [
    {
      "id": "searchProducts",
      "label": "Search products",
      "description": "Searches Blueprint products by name or keyword.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "minLength": 1 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 10, "default": 4 }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/$defs/productSummary" } },
          "nextCursor": { "type": ["string", "null"] }
        },
        "required": ["items", "nextCursor"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false,
      "defaultArgs": { "query": "longevity", "limit": 4 }
    },
    {
      "id": "listFavoriteProducts",
      "label": "List Bryan's favorites",
      "description": "Lists products from the Blueprint store's Bryan's Favorites collection with purchasable variants.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 4 }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/$defs/product" } },
          "nextCursor": { "type": ["string", "null"] }
        },
        "required": ["items", "nextCursor"],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false,
      "defaultArgs": { "limit": 4 }
    },
    {
      "id": "getVariant",
      "label": "Get product variant",
      "description": "Returns a Blueprint variant's SKU, price, size, currency, and shipping weight.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "outputSchema": { "$ref": "#/$defs/variant" },
      "requireApproval": false,
      "requireAuth": false,
      "defaultArgs": { "id": "51937822638365" }
    },
    {
      "id": "getCart",
      "label": "View cart",
      "description": "Returns the anonymous Blueprint cart with quantities and totals.",
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "outputSchema": { "$ref": "#/$defs/cart" },
      "requireApproval": false,
      "requireAuth": false,
      "defaultArgs": {}
    },
    {
      "id": "addCartItem",
      "label": "Add cart item",
      "description": "Adds a Blueprint variant to the anonymous cart. This does not place an order or charge money.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "variantId": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 10 },
          "sellingPlanId": { "type": "string", "minLength": 1 }
        },
        "required": ["variantId", "quantity"],
        "additionalProperties": false
      },
      "outputSchema": { "$ref": "#/$defs/cartItem" },
      "requireApproval": true,
      "requireAuth": false,
      "defaultArgs": {
        "variantId": "51937822638365",
        "quantity": 1,
        "sellingPlanId": "690578391325"
      }
    }
  ]
}
