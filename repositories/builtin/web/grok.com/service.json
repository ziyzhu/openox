{
  "domain": "grok.com",
  "name": "Grok",
  "description": "Search saved Grok conversations, browse recent history, read messages, and send prompts with approval.",
  "baseUrl": "https://grok.com/",
  "faviconUrl": "https://grok.com/images/apple-touch-icon.png",
  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Get sign-in URL",
      "description": "Open Grok sign-in.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "getSignInState",
      "label": "Check sign-in",
      "description": "Check the current server session.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false
    },
    {
      "id": "listConversations",
      "label": "List conversations",
      "description": "Read up to 60 recent conversations. Further pagination is not yet supported; nextCursor indicates additional results.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60,
            "default": 20
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "conversationId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "createTime": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "modifyTime": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "conversationId",
                "title",
                "url",
                "createTime",
                "modifyTime"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "openConversation",
      "label": "Open conversation",
      "description": "Open an exact conversation from the loaded sidebar; older unrendered conversations are not supported.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9-]+$"
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "rendered"
            ]
          }
        },
        "required": [
          "conversationId",
          "url",
          "messages",
          "status"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "getCurrentConversation",
      "label": "Read current conversation",
      "description": "Read a conversation by ID directly from Grok, without waiting for the sidebar. Returns message text and complete or pending status. Up to 200 messages; branched histories are not supported.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9-]+$"
          }
        },
        "required": [
          "conversationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "pending"
            ]
          }
        },
        "required": [
          "conversationId",
          "url",
          "messages",
          "status"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "chat",
      "label": "Start chat",
      "description": "Send one prompt in a new Grok conversation using its native form. Requires approval and preserves existing drafts. Accepted confirms a fresh matching user message and conversation ID, not a completed reply. Read the conversation separately for the response. Never retry an uncertain result automatically.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          }
        },
        "required": [
          "prompt"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "uncertain"
            ]
          },
          "submissionConfirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "conversationId",
          "url",
          "messages",
          "status",
          "submissionConfirmed"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "continueChat",
      "label": "Continue chat",
      "description": "Reopen the requested sidebar conversation and send one prompt using its native form. Requires approval and preserves existing drafts. Accepted confirms a fresh matching user message and conversation ID, not a completed reply. Read the conversation separately for the response. Never retry an uncertain result automatically.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9-]+$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30000
          }
        },
        "required": [
          "conversationId",
          "prompt"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "uncertain"
            ]
          },
          "submissionConfirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "conversationId",
          "url",
          "messages",
          "status",
          "submissionConfirmed"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "getInterfaceState",
      "label": "Check chat readiness",
      "description": "Read bounded editor and submission readiness without exposing draft text or sending messages.",
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "editorPresent": {
            "type": "boolean"
          },
          "domLength": {
            "type": "integer"
          },
          "stateLength": {
            "type": "integer"
          },
          "testDraftMatches": {
            "type": "boolean"
          },
          "messageCount": {
            "type": "integer"
          },
          "submitPresent": {
            "type": "boolean"
          },
          "submitDisabled": {
            "type": "boolean"
          },
          "sidebarIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "path",
          "editorPresent",
          "domLength",
          "stateLength",
          "testDraftMatches",
          "messageCount",
          "submitPresent",
          "submitDisabled"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "searchConversations",
      "label": "Search saved chats",
      "description": "Search saved chats using Grok search, up to 60 source-ranked matches. Native matching may not behave like substring search. More-result continuation is unverified and raises an explicit error; narrow the query. Read returned IDs with getCurrentConversation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "listModels",
      "label": "List provider models",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "input": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "text",
                      "image",
                      "pdf"
                    ]
                  }
                },
                "contextTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "outputTokens": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "streaming": {
                  "type": "boolean"
                },
                "cancellation": {
                  "type": "boolean"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "temperature",
                      "maxTokens"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "name",
                "input",
                "contextTokens",
                "outputTokens",
                "streaming",
                "cancellation",
                "options"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "models"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "startModelGeneration",
      "label": "Start model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "modelId": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "user",
                    "assistant",
                    "tool"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "name": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "mimeType"
              ],
              "additionalProperties": false
            }
          },
          "options": {
            "type": "object",
            "properties": {
              "temperature": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxTokens": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "temperature",
              "maxTokens"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "modelId",
          "messages",
          "attachments",
          "options"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          },
          "submission": {
            "type": "string",
            "enum": [
              "uncertain",
              "confirmed"
            ]
          }
        },
        "required": [
          "generationId",
          "submission"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true
    },
    {
      "id": "readModelGeneration",
      "label": "Read model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          },
          "after": {
            "type": "integer",
            "minimum": 0
          },
          "waitMilliseconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "required": [
          "generationId",
          "after",
          "waitMilliseconds"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "text"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "completed"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "failed"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "contextOverflow",
                        "rateLimited",
                        "network",
                        "authentication",
                        "unsupportedInput",
                        "provider"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "message",
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "nextCursor",
          "events"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false
    },
    {
      "id": "cancelModelGeneration",
      "label": "Cancel model generation",
      "description": "Standard model provider Action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "generationId": {
            "type": "string"
          }
        },
        "required": [
          "generationId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "cancelled",
              "requested",
              "completed",
              "unsupported"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true
    }
  ]
}
