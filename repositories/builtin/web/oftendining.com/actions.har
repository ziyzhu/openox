            "text": "<style> #account-profile .password-panel, #account-profile .curbside-panel, #account-profile .dsp-delivery-notes-panel{ display: none; }\r\n</style><div class=\"page-account-profile\" id=\"page-account-profile\"><div class=\"container page-well\"><div class=\"\"><div class=\"row\"><div class=\"col-xs-12\"><h3 class=\"page-first-heading page-heading\">Your Profile</h3></div></div><div role=\"form\" class=\"well\" id=\"account-profile\"><div class=\"row\"><div class=\"col-sm-6\"><div class=\"form-group\"><label class=\"control-label\" for=\"first-name\">First Name</label> <input class=\"form-control required text[1,255]\" id=\"first-name\" placeholder=\"First Name\" name=\"first_name\" type=\"text\" value=\"Alex\"></div></div><div class=\"col-sm-6\"><div class=\"form-group\"><label class=\"control-label\" for=\"last-name\">Last Name</label> <input class=\"form-control required text[1,255]\" id=\"last-name\" placeholder=\"Last Name\" name=\"last_name\" type=\"text\" value=\"Morgan\"></div></div></div><div class=\"row\"><div class=\"col-sm-6\"><div class=\"form-group\"><label class=\"control-label\" for=\"phone\">Mobile Phone</label> <input class=\"form-control required phone text[10]\" id=\"phone\" placeholder=\"Mobile Phone\" name=\"sms_number\" type=\"text\" value=\"(555) 010-0123\"></div></div></div><div class=\"row\"><div class=\"col-sm-6\"><div class=\"form-group\"><label class=\"control-label\" for=\"email\">Email/Username</label> ziyMorgan.life@gmail.com</div></div></div><div class=\"row\"><div class=\"col-xs-12\"><div class=\"form-group\"><input type=\"checkbox\" id=\"password-change\" name=\"password_change\" value=\"1\"> <label class=\"control-label\" for=\"password-change\">Change Password</label></div></div></div><div class=\"password-panel\"><div class=\"row\"><div class=\"col-sm-6\"><div class=\"form-group\"><label class=\"control-label\" for=\"password-current\">Current Password</label> <input class=\"form-control condReq[password-change]\" name=\"password_current\" id=\"password-current\" placeholder=\"Password\" type=\"password\"></div></div></div><div class=\"row\"><div class=\"col-sm-6\"><div class=\"form-group\"><label class=\"control-label\" for=\"password-create\">New Password</label> <input class=\"form-control condReq[password-change] text[6,255]\" name=\"password_new\" id=\"password-create\" placeholder=\"New Password\" type=\"password\" autocomplete=\"new-password\"></div></div><div class=\"col-sm-6\"><div class=\"form-group\"><label class=\"control-label\" for=\"confirm-password\">Confirm Password</label> <input class=\"form-control condReq[password-change] equals[password-create] text[6,255]\" name=\"password_confirm\" id=\"confirm-password\" placeholder=\"Confirm Password\" type=\"password\"></div></div></div></div><div class=\"row\"><div class=\"col-xs-12\"><div class=\"form-group\"><input type=\"checkbox\" id=\"curbside-change\" name=\"curbside_change\" value=\"1\"> <label class=\"control-label\" for=\"curbside-change\">Change Curbside Pickup Default Information</label></div></div></div><div class=\"curbside-panel\"><div class=\"row\"><div class=\"col-sm-6\"><div class=\"form-group\"><label class=\"control-label\" for=\"curbside-make\">Brand / Make</label> <input type=\"text\" class=\"form-control condReq[curbside-make] condReq[curbside-model] condReq[curbside-color] text[0,25]\" name=\"curbside_make\" id=\"curbside-make\" placeholder=\"ex. Honda\" value=\"\"></div></div><div class=\"col-sm-6\"><div class=\"form-group\"><label class=\"control-label\" for=\"curbside-model\">Type / Model</label> <input type=\"text\" class=\"form-control condReq[curbside-make] condReq[curbside-model] condReq[curbside-color] text[0,25]\" name=\"curbside_model\" id=\"curbside-model\" placeholder=\"ex. Civic\" value=\"\"></div></div></div><div class=\"row\"><div class=\"col-sm-6\"><div class=\"form-group\"><label class=\"control-label\" for=\"curbside-color\">Color</label> <input type=\"text\" class=\"form-control condReq[curbside-make] condReq[curbside-model] condReq[curbside-color] text[0,25]\" name=\"curbside_color\" id=\"curbside-color\" placeholder=\"ex. Red\" value=\"\"></div></div><div class=\"col-sm-6\"><div class=\"form-group\"><label class=\"control-label\" for=\"curbside-license-plate\">License Plate (Optional)</label> <input type=\"text\" class=\"form-control text[0,25]\" name=\"curbside_license_plate\" id=\"curbside-license-plate\" placeholder=\"ex. V5S 7X1\" value=\"\"></div></div></div></div><div class=\"row\"><div class=\"col-xs-12\"><button type=\"button\" class=\"btn btn-primary save-profile\"> <span class=\"icon-wrapper\"> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" aria-hidden=\"true\"><g fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1\" stroke=\"currentColor\"><path d=\"M10.75,2.25v3c0,.552-.448,1-1,1h-3.5c-.552,0-1-.448-1-1V2.25\"></path><path d=\"M5.25,15.75v-5c0-.552,.448-1,1-1h5.5c.552,0,1,.448,1,1v5\"></path><path d=\"M13.59,15.75H4.41c-1.193,0-2.16-.967-2.16-2.16V4.41c0-1.193,.967-2.16,2.16-2.16h7.426c.265,0,.52,.105,.707,.293l2.914,2.914c.188,.188,.293,.442,.293,.707v7.426c0,1.193-.967,2.16-2.16,2.16Z\"></path></g></svg> </span> Save </button>  <button class=\"btn btn-link deactivate-account pull-right\"> <span class=\"icon-wrapper\"> <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" aria-hidden=\"true\"><g fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1\" stroke=\"currentColor\"><path d=\"M2.75 4.75H15.25\"></path> <path d=\"M6.75 4.75V2.75C6.75 2.2 7.198 1.75 7.75 1.75H10.25C10.802 1.75 11.25 2.2 11.25 2.75V4.75\"></path> <path d=\"M7.375 8.75L7.59219 13.25\"></path> <path d=\"M10.625 8.75L10.4078 13.25\"></path> <path d=\"M13.6977 7.75L13.35 14.35C13.294 15.4201 12.416 16.25 11.353 16.25H6.64804C5.58404 16.25 4.70703 15.42 4.65103 14.35L4.30334 7.75\"></path></g></svg> </span> Deactivate Account </button> </div></div></div></div></div></div><script>\r\nnavEngine.pageInit('page-account-profile', function( $p ) {\r\n$p('.save-profile').click(function() {\r\nif ( !$p.validate() ) return;\r\nvar update = $p.serializeData();\r\n$p.request({\r\naction : 'update',\r\njson : update,\r\nsuccess : function(){\r\nnavEngine.notice('Saved');\r\nnavEngine.reload();\r\n},\r\nerror : function(){\r\nnavEngine.notice('Problem With Request');\r\nnavEngine.reload();\r\n}\r\n});\r\n\r\n});\r\n\r\n$p('[name=\"password_change\"]').bind( 'change', function() {\r\nif ( this.checked )\r\n$p('.password-panel').show('fast');\r\nelse\r\n$p('.password-panel').hide('fast');\r\n});\r\n\r\n$p('[name=\"curbside_change\"]').bind( 'change', function() {\r\nif ( this.checked )\r\n$p('.curbside-panel').show('fast');\r\nelse\r\n$p('.curbside-panel').hide('fast');\r\n});\r\n\r\n$p('.deactivate-account').click(function() {\r\nnavEngine.forward( 'https://oftendining.com/account_deactivate.php', false);\r\n});\r\n\r\n$p.validationEngine({\r\npromptPosition: \"bottomLeft\"\r\n});\r\n\r\n\r\n});\r\n</script>"
