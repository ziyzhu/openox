div></div></div></div><div class=\"text-center\"><button class=\"load-more btn btn-lg btn-block btn-link\"> Load More </button></div></div></div><script>\r\nnavEngine.pageInit('account-orders', function( $p ) {\r\n\r\nfunction loadControls($obj){\r\n$obj.find('.invoice-header').on('click', function(){\r\nvar $header = $(this);\r\n$p('i.accordion-header-icon.fa-chevron-down').removeClass('fa-chevron-down').addClass('fa-chevron-right');\r\nvar $panel = $p($(this).attr('href'));\r\nif (!$panel.hasClass('in')){\r\n//accordion is opening\r\n$(this).find('i.accordion-header-icon').removeClass('fa-chevron-right').addClass('fa-chevron-down');\r\n\r\n$p('#page-order-receipt').closest('.panel-body').empty(); //empty out old receipts until I can figure out how to bind frame's $p uniquely\r\n\r\nif (!($header.attr('loaded'))){\r\n//receipt isn't loaded, load into panel\r\nvar sid = $(this).attr('data-store-id');\r\nvar iid = $(this).attr('data-invoice-id');\r\nnavEngine.frame($panel.find('.panel-body').empty(), 'https://oftendining.com/order_receipt.php?', {\r\nstore_id : sid,\r\ninvoice_id : iid,\r\nframe : 1\r\n});\r\n//$header.attr('loaded', \"1\"); //temporarily disabled until I can figure out how to bind frame's $p uniquely\r\n}\r\n}\r\n});\r\n\r\n$obj.find('.panel-body').on('print', function() {\r\nvar printArea = $('#print-area');\r\nvar body = $(this);\r\nbody.find('script').remove();\r\nprintArea.html( body.html() );\r\nwindow.print();\r\nprintArea.empty();\r\n});\r\n}\r\nloadControls($p('.panel'));\r\n\r\nvar pageSize = 10;\r\nvar offset = 10;\r\nvar $accordion = $p('#accordion');\r\nvar $loadMore = $p('.load-more');\r\n$loadMore.on('click', function(){\r\n$p.request({\r\naction : 'load',\r\njson : {\r\noffset : offset\r\n},\r\nsuccess : function(result) {\r\nvar data = $( $.parseHTML(result.orders) );\r\nif ( data && data.length >= 1 ) {\r\nloadControls(data);\r\n$accordion.append(data);\r\noffset += pageSize;\r\nif (result.eol) $loadMore.hide();\r\n} else {\r\n$loadMore.hide();\r\n}\r\nif ( window._gtmH) _gtmH.trackPage('/account_orders.php');\r\n}\r\n});\r\n});\r\n\r\nif ( window._gtmH) _gtmH.trackPage('/account_orders.php');\r\n});\r\n</script>"
