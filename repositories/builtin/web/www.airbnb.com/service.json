  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in to Airbnb",
      "description": "Opens the Airbnb sign-in page.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getSignInState",
      "label": "Check Airbnb sign-in",
      "description": "Checks whether you are signed in to Airbnb.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "searchStays",
      "label": "Search stays",
      "description": "Searches Airbnb homes for exact travel dates and guest counts, optionally filtering by bathrooms, free parking, and maximum price, with displayed prices, ratings, key room details, and listing links.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Destination, neighborhood, or landmark."
          },
          "checkIn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Check-in date in YYYY-MM-DD format."
          },
          "checkOut": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Check-out date in YYYY-MM-DD format."
          },
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "default": 1
          },
          "children": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15,
            "default": 0
          },
          "infants": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "default": 0
          },
          "pets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "default": 0
          },
          "minBathrooms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50,
            "description": "Minimum number of bathrooms."
          },
          "freeParking": {
            "type": "boolean",
            "default": false,
            "description": "Only return homes offering free parking."
          },
          "maxPrice": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000,
            "description": "Maximum Airbnb price-filter amount in USD for the selected stay."
          },
          "cursor": {
            "type": "string",
            "description": "Pagination token returned by the previous search."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18,
            "default": 18
          }
        },
        "required": [
          "query",
          "checkIn",
          "checkOut"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/stay"
            }
          },
          "nextCursor": {
            "$ref": "#/$defs/nullableString"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getStay",
      "label": "Get stay details",
      "description": "Returns one Airbnb home's description, capacity, rooms, rating, host, amenities, rules, safety notes, approximate location, and photos. Choose a home from stay search.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Listing id or Airbnb room URL returned by stay search."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/stayDetails"
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getStayAvailability",
      "label": "Check stay availability",
      "description": "Returns daily availability for one Airbnb home across up to 12 months, including allowed arrival and departure dates, stay-length rules, and displayed daily prices when available.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Listing id or Airbnb room URL returned by stay search."
          },
          "startMonth": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "description": "First calendar month in YYYY-MM format."
          },
          "months": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "default": 12,
            "description": "Number of consecutive months to return."
          }
        },
        "required": [
          "id",
          "startMonth"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "months": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/stayAvailabilityMonth"
            }
          }
        },
        "required": [
          "id",
          "months"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "listStayReviews",
      "label": "List stay reviews",
      "description": "Lists guest reviews for one Airbnb home with ratings, dates, reviewer details, comments, and host responses.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Listing id or Airbnb room URL returned by stay search."
          },
          "cursor": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Offset returned by the previous review page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24,
            "default": 24
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/stayReview"
            }
          },
          "nextCursor": {
            "$ref": "#/$defs/nullableString"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getPaymentUrl",
      "label": "Review stay checkout",
      "description": "Opens Airbnb checkout for the selected home, dates, and guests so you can review the price and policies, then personally submit and pay for the reservation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string",
            "minLength": 1,
            "description": "Listing id or Airbnb room URL returned by stay search."
          },
          "checkIn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Check-in date in YYYY-MM-DD format."
          },
          "checkOut": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Check-out date in YYYY-MM-DD format."
          },
          "adults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "default": 1
          },
          "children": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15,
            "default": 0
          },
          "infants": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "default": 0
          },
          "pets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "default": 0
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "default": "USD",
            "description": "Three-letter currency code for displayed checkout prices."
          },
          "isWorkTrip": {
            "type": "boolean",
            "default": false,
            "description": "Whether to mark the reservation as a work trip."
          }
        },
        "required": [
          "listingId",
          "checkIn",
          "checkOut"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false,
      "baseUrl": "https://www.airbnb.com/"
    },
    {
      "id": "getPaymentState",
      "label": "Check stay checkout",
      "description": "Checks whether the selected Airbnb reservation is awaiting your review, has been submitted, or is no longer active. A submitted reservation includes its confirmation code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string",
            "minLength": 1,
            "description": "Listing id or Airbnb room URL returned by stay search."
          },
          "checkIn": {
