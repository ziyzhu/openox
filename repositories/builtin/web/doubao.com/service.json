{
  "domain": "doubao.com",
  "name": "Doubao",
  "description": "Chat with Doubao, read rendered messages, and reopen recent conversations. Sign-in required; sending requires approval. Full-history search, model switching and attachments are not supported.",
  "baseUrl": "https://www.doubao.com/chat/",
  "faviconUrl": "https://lf-flow-web-cdn.doubao.com/obj/flow-doubao/favicon/new-doubao/180x180.png",
  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in",
      "description": "Open Doubao sign-in.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false,
      "baseUrl": "https://www.doubao.com/robots.txt"
    },
    {
      "id": "getSignInState",
      "label": "Check sign-in",
      "description": "Check a fresh server-rendered session response, not local browser state.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "requireAuth": false,
      "requireApproval": false,
      "baseUrl": "https://www.doubao.com/robots.txt"
    },
    {
      "id": "getCurrentConversation",
      "label": "Read current chat",
      "description": "Read bounded rendered messages and loaded sidebar titles. Does not return complete history or paginate older chats.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "conversationRef": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "assistant"
                  ]
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "role",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "renderedOnly": {
            "type": "boolean"
          },
          "truncated": {
            "type": "boolean"
          },
          "recentConversations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "conversationRef": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "conversationRef"
              ],
              "additionalProperties": false
            }
          },
          "interfaceState": {
            "type": "object",
            "properties": {
              "editorCount": {
                "type": "integer"
              },
              "draftLength": {
                "type": "integer"
              },
              "docLength": {
                "type": "integer"
              },
              "editorInitialized": {
                "type": "boolean"
              },
              "sameView": {
                "type": "boolean"
              },
              "editorStateSynchronized": {
                "type": "boolean"
              },
              "animationFrameObserved": {
                "type": "boolean"
              }
            },
            "required": [
              "editorCount",
              "draftLength",
              "docLength",
              "editorInitialized",
              "sameView",
              "editorStateSynchronized",
              "animationFrameObserved"
            ],
            "additionalProperties": false
          },
          "lastSubmissionEvents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "status": {
                  "type": "integer"
                }
              },
              "required": [
                "method",
                "path",
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "url",
          "conversationRef",
          "messages",
          "renderedOnly",
          "truncated",
          "recentConversations",
          "interfaceState",
          "lastSubmissionEvents"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "openConversation",
      "label": "Open recent chat",
      "description": "Open a unique exact title from the loaded sidebar. Older unloaded chats and ambiguous titles are rejected.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "conversationRef": {
            "type": "string"
          }
        },
        "required": [
          "url",
          "conversationRef"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": false,
      "blocking": true
    },
    {
      "id": "chat",
      "label": "New chat",
      "description": "Start a fresh text chat after approval. Refuses to discard an existing draft. A reply may still be generating; pending submissions must not be repeated.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "conversationRef": {
            "type": "string"
          },
          "response": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "reply_observed",
              "pending"
            ]
          },
          "submissionConfirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "conversationRef",
          "response",
          "status",
          "submissionConfirmed"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "continueChat",
      "label": "Continue current chat",
      "description": "Send one follow-up after approval using the current conversationRef. Rejects stale references and existing drafts. Read current chat after pending results; do not resend.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "conversationRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          }
        },
        "required": [
          "conversationRef",
          "message"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "conversationRef": {
            "type": "string"
          },
          "response": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "reply_observed",
              "pending"
            ]
          },
          "submissionConfirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "conversationRef",
          "response",
          "status",
          "submissionConfirmed"
        ],
        "additionalProperties": false
      },
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true
    },
    {
      "id": "diagnoseComposer",
      "label": "Test editor without sending",
      "description": "Temporarily insert a fixed diagnostic draft, inspect Send readiness, and remove only that exact draft. Never clicks Send; refuses existing drafts.",
      "requireAuth": true,
      "requireApproval": true,
      "blocking": true,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "draftAccepted": {
            "type": "boolean"
          },
          "draftCleared": {
            "type": "boolean"
          },
          "editorStateSynchronized": {
            "type": "boolean"
          },
          "buttonCount": {
            "type": "integer"
          },
          "sendHandlerPresent": {
            "type": "boolean"
          },
          "sendEnabled": {
            "type": "boolean"
          },
          "buttonConnected": {
            "type": "boolean"
          }
        },
        "required": [
          "draftAccepted",
          "draftCleared",
          "editorStateSynchronized",
          "buttonCount",
          "sendHandlerPresent",
          "sendEnabled",
          "buttonConnected"
        ],
        "additionalProperties": false
      }
    }
  ]
}