  "locales": {
    "zh-Hans": {
      "name": "定位",
      "description": "读取精确到城市级别的大致位置，用于附近搜索、当地价格和天气查询。",
      "actions": {
        "current": {
          "label": "当前位置",
          "description": "获取精确到城市级别的大致位置。"
        },
        "searchNearby": {
          "label": "搜索附近地点",
          "description": "在 Apple 地图中搜索附近地点，同时将你的精确坐标保留在设备上。"
        },
        "resolve": {
          "label": "解析地址",
          "description": "将地址解析为 Apple 地图中的地点。"
        },
        "route": {
          "label": "路线和预计到达时间",
          "description": "根据你的当前位置计算距离和预计到达时间。"
        },
        "openInMaps": {
          "label": "在地图中打开",
          "description": "在 Apple 地图中打开已解析的地点或路线。"
        }
      }
    }
  }
