{
  "domain": "ios:health",
  "name": "Health",
  "description": "Read bounded activity, sleep, workout, vital, and body summaries allowed by iOS.",
  "icon": {
    "asset": "ios:health"
  },
  "permission": "health",
  "supportedIOS": {
    "minimum": "26.0"
  },
  "actions": [
    {
      "description": "Read bounded daily activity totals from Apple Health.",
      "id": "activity",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "description": "Exclusive ISO-8601 end timestamp, no more than 31 days after start.",
            "type": "string"
          },
          "start": {
            "description": "Inclusive ISO-8601 start timestamp.",
            "type": "string"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "type": "object"
      },
      "label": "Read activity",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "days": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "activeEnergyKcal": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "date": {
                  "type": "string"
                },
                "exerciseMinutes": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "steps": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "walkingRunningDistanceMeters": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "activeEnergyKcal",
                "date",
                "exerciseMinutes",
                "steps",
                "walkingRunningDistanceMeters"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "end": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "timezone",
          "days"
        ],
        "type": "object"
      },
      "requireApproval": false,
      "requireAuth": false
    },
