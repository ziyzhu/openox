      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "days": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "bodyFatPercent": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "date": {
                  "type": "string"
                },
                "leanBodyMassKg": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "weightKg": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "bodyFatPercent",
                "date",
                "leanBodyMassKg",
                "weightKg"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "end": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "timezone",
          "days"
        ],
        "type": "object"
      },
      "requireApproval": false,
      "requireAuth": false
    },
