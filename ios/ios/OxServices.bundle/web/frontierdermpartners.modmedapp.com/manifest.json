  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in to Frontier Derm Partners",
      "description": "Opens the patient portal sign-in page.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getSignInState",
      "label": "Check Frontier Derm Partners sign-in",
      "description": "Checks whether the patient portal is signed in.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getPatientProfile",
      "label": "Get my patient profile",
      "description": "Returns your contact and demographic details while excluding Social Security and driver's license numbers.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "$ref": "#/$defs/profile"
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://frontierdermpartners.modmedapp.com/patient-portal"
    },
    {
      "id": "listPastAppointments",
      "label": "List past appointments",
      "description": "Returns your ten most recent past dermatology visits, including providers, facilities, and available visit-note links.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/appointment"
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://frontierdermpartners.modmedapp.com/patient-portal"
    },
    {
      "id": "getMedicationHistory",
      "label": "Get my medications",
      "description": "Returns medications recorded in your dermatology chart and whether no medications are reported.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "noneReported": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/medication"
            }
          }
        },
        "required": [
          "noneReported",
          "items"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://frontierdermpartners.modmedapp.com/patient-portal"
    },
    {
      "id": "listProblems",
      "label": "List health concerns",
      "description": "Returns the health concerns recorded in your dermatology chart.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/problem"
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://frontierdermpartners.modmedapp.com/patient-portal"
    },
    {
      "id": "getAllergySummary",
      "label": "Get my allergy summary",
      "description": "Returns whether no known allergies are recorded, any free-text allergy note, and the number of listed allergies.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "noneKnown": {
            "type": "boolean"
          },
          "otherAllergies": {
            "type": [
              "string",
              "null"
            ]
          },
          "recordedAllergyCount": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "noneKnown",
          "otherAllergies",
          "recordedAllergyCount"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://frontierdermpartners.modmedapp.com/patient-portal"
    },
    {
      "id": "getBillingSummary",
      "label": "Get my billing summary",
      "description": "Returns current balances and up to ten recent statements without tax identifiers or payment-card details.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/billingAccount"
            }
          },
          "recentStatements": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/statement"
            }
          }
        },
        "required": [
          "accounts",
          "recentStatements"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://frontierdermpartners.modmedapp.com/patient-portal"
    },
    {
      "id": "listInsurancePlans",
      "label": "List active insurance",
      "description": "Returns active insurance coverage details while excluding policy and group numbers.",
