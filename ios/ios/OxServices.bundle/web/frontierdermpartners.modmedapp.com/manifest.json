            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://frontierdermpartners.modmedapp.com/patient-portal"
    },
    {
