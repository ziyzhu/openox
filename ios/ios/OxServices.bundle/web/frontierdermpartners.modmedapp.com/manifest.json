      "label": "List my pharmacies",
      "description": "Returns pharmacies saved in your patient portal, including contact details and the default pharmacy.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/pharmacy"
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": true,
      "baseUrl": "https://frontierdermpartners.modmedapp.com/patient-portal"
    }
