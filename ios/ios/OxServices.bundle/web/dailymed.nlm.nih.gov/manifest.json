{
  "domain": "dailymed.nlm.nih.gov",
  "name": "DailyMed",
  "description": "The official source for FDA drug label information. Search human and animal drug labels and read labeling sections, status details, and official downloads. Public and read-only; no sign-in required.",
  "baseUrl": "https://dailymed.nlm.nih.gov/dailymed/autocomplete.cfm?key=search&returntype=json&term=zzzzunlikelyqueryzzzz",
  "$defs": {
    "searchResult": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The label's DailyMed Set ID."
        },
        "title": {
          "type": "string"
        },
        "ndcCodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packager": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "ndcCodes",
        "url"
      ],
      "additionalProperties": false
    },
    "labelSection": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "description": "The section's standard LOINC code when DailyMed provides one."
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "code",
        "text"
      ],
      "additionalProperties": false
    }
  },
  "actions": [
    {
      "id": "searchDrugLabels",
      "label": "Search drug labels",
      "description": "Searches human or animal drug labels by a general term or a specific label field and returns matching products, NDC codes, packagers, and links.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Drug name, code, ingredient, class, or other label term to find."
          },
          "field": {
            "type": "string",
            "enum": [
              "all",
              "name",
              "ndc",
              "applicationNumber",
              "setId",
              "documentId",
              "drugClass",
              "activeMoiety",
              "activeIngredient",
              "inactiveIngredient"
            ],
            "default": "all",
            "description": "Optional label field to search; use all for a general DailyMed search."
          },
          "labelType": {
            "type": "string",
            "enum": [
              "all",
              "human",
              "animal"
            ],
            "default": "all",
            "description": "Whether to include all labels or only human or animal drugs."
          },
          "cursor": {
            "type": "string",
            "description": "Page cursor returned by the previous search."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 20,
            "description": "Maximum results to return on this page."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/searchResult"
            }
          },
          "totalCount": {
            "type": "integer"
          },
          "nextCursor": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "totalCount",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {
        "query": "Aspirin"
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getDrugLabel",
      "label": "Read a drug label",
      "description": "Reads a DailyMed drug label with its NDC codes, packager, category, marketing status, dated labeling sections, and official downloads.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "DailyMed Set ID from a search result."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "ndcCodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "packager": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "deaSchedule": {
            "type": "string"
          },
          "marketingStatus": {
            "type": "string"
          },
          "updated": {
            "type": "string"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/labelSection"
            }
          },
          "url": {
            "type": "string"
          },
          "pdfUrl": {
            "type": "string"
          },
          "xmlZipUrl": {
            "type": "string"
          },
          "officialLabelUrl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "ndcCodes",
          "sections",
          "url"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {
        "id": "7d1950b4-3237-4512-bab3-4c7364bdd618"
      },
      "requireApproval": false,
      "requireAuth": false
    }
  ],
  "faviconUrl": "https://openox.ai/assets/services/dailymed.nlm.nih.gov/favicon.png"
}