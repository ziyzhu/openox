    {
      "id": "listPaymentActivities",
      "label": "List payments and transfers",
      "description": "Lists payments, transfers, wires, bill payments, and Zelle activity, with optional account, date, amount, type, status, and keyword filters.",
      "requireAuth": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "The next page returned by the previous call."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "timeframe": {
            "type": "string",
            "enum": [
              "THIRTYDAYS",
              "SIXTYDAYS",
              "NINETYDAYS",
              "DEFAULTDAYS",
              "THREEMONTHS",
              "SIXMONTHS",
              "TWELVEMONTHS",
              "EIGHTEENMONTHS",
              "EXTENDEDHISTORY",
              "CUSTOMDATE"
            ],
            "default": "DEFAULTDAYS",
            "description": "A date range returned by getPaymentActivityFilters, or CUSTOMDATE with fromDate and toDate."
          },
          "fromDate": {
            "type": "string",
            "description": "Start date for CUSTOMDATE."
          },
          "toDate": {
            "type": "string",
            "description": "End date for CUSTOMDATE."
          },
          "fromAccountIdentifiers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Source account identifiers returned by getPaymentActivityFilters."
          },
          "toAccountIdentifiers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Destination account identifiers returned by getPaymentActivityFilters."
          },
          "keyword": {
            "type": "string"
          },
          "minimumAmount": {
            "type": "number",
            "minimum": 0
          },
          "maximumAmount": {
            "type": "number",
            "minimum": 0
          },
          "activityTypes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Activity types returned by getPaymentActivityFilters."
          },
          "statuses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Statuses returned by getPaymentActivityFilters."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/paymentActivity"
            }
