        "getPayTransferUrl": {
          "label": "打开付款和转账",
          "description": "打开付款和转账记录页面。"
        },
        "getSignInUrl": {
          "label": "登录美国银行",
          "description": "打开美国银行登录页。"
        },
        "getSignInState": {
          "label": "检查美国银行登录状态",
          "description": "检查你是否已登录美国银行。"
        },
        "listAccounts": {
          "label": "账户列表",
          "description": "列出你的账户，以及查看每个账户所需的信息。"
        },
        "getAccount": {
          "label": "获取账户明细",
          "description": "读取单个账户的明细。"
        },
        "getPaymentActivityFilters": {
          "label": "付款记录筛选条件",
          "description": "读取可用于筛选付款和转账记录的账户、日期范围、状态和类型。"
        },
        "listPaymentActivities": {
          "label": "付款和转账记录",
          "description": "列出付款、转账、电汇、账单支付和 Zelle 记录，可按账户、日期、金额、类型、状态或关键词筛选。"
        },
        "listTransactions": {
          "label": "交易列表",
          "description": "列出单个账户的近期交易。"
        },
        "listStatements": {
          "label": "对账单列表",
          "description": "列出某账户某年的对账单文件。"
        },
        "getSpending": {
          "label": "消费洞察",
          "description": "读取按类别划分的消费洞察。"
        },
        "listDeals": {
          "label": "返现优惠",
          "description": "列出 BankAmeriDeals 返现优惠。"
        }
      }
