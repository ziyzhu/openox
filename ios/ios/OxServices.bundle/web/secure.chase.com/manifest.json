    {
      "id": "createPayment",
      "label": "Pay a bill",
      "description": "Schedules a bill payment to a saved payee using your chosen account, amount, and available payment date. Requires your approval before submission.",
      "requireAuth": true,
      "requireApproval": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "payeeId": {
            "type": [
              "string",
              "integer"
            ]
          },
          "amount": {
            "type": "number"
          },
          "paymentDate": {
            "type": "string",
            "description": "YYYYMMDD; defaults to the earliest available date."
          },
          "fundingAccountId": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Defaults to the default funding account."
          },
          "paymentOption": {
            "type": "string",
            "enum": [
              "STATEMENT_BALANCE",
              "CURRENT_BALANCE",
              "MINIMUM_PAYMENT_DUE",
              "INTEREST_SAVING_BALANCE",
              "REMAINING_STATEMENT_BALANCE",
              "OTHER_AMOUNT"
            ]
          }
        },
        "required": [
          "payeeId"
        ],
        "additionalProperties": false
      },
