    {
      "id": "listTransactions",
      "label": "List transactions",
      "description": "List posted and pending transactions for one card account, newest first. Defaults to the last 2 years; pass startDate/endDate (YYYY-MM-DD) to narrow.",
      "requireAuth": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": [
              "string",
              "integer"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "description": "YYYY-MM-DD; defaults to 2 years ago."
          },
          "endDate": {
            "type": "string",
            "description": "YYYY-MM-DD; defaults to today."
          }
        },
        "required": [
          "accountId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/transaction"
            }
          },
          "nextCursor": {
            "type": [
