  "locales": {
    "zh-Hans": {
      "name": "大通银行",
      "description": "美国个人银行服务。查看信用卡账户、余额、还款到期日、账户明细、近期交易和积分余额，还可向已保存的收款人支付账单。需登录。",
      "actions": {
        "getSignInUrl": {
          "label": "登录大通银行",
          "description": "打开大通银行登录页。"
        },
        "getSignInState": {
          "label": "检查大通登录状态",
          "description": "检查你是否已登录大通银行。"
        },
        "listAccounts": {
          "label": "账户列表",
          "description": "列出已登录用户的账户及余额、还款到期信息。"
        },
        "getAccount": {
          "label": "获取账户明细",
          "description": "读取单张卡账户的明细：账单余额、可用额度、年利率、自动还款、最近一次还款。"
        },
        "listTransactions": {
          "label": "交易列表",
          "description": "列出单张卡账户近期的已入账和待处理交易。"
        },
        "getRewards": {
          "label": "获取积分余额",
          "description": "读取用户各卡的积分余额。"
        },
        "listPayees": {
          "label": "收款人列表",
          "description": "列出可在大通账单支付中支付的收款人（信用卡、贷款、商户）。"
        },
        "createPayment": {
          "label": "支付账单",
          "description": "使用你选择的账户、金额和可用付款日期，向已保存的收款人安排账单付款。提交前需你批准。"
        }
      }
    }
