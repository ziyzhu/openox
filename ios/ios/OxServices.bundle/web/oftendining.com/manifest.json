{
  "domain": "oftendining.com",
  "name": "Often Dining",
  "description": "Online ordering platform for local restaurants. Search nearby restaurants by location, browse a restaurant's menu with prices and photos, and build a priced pickup cart; the user reviews and pays in the restaurant's own checkout, and the receipt is readable afterward by invoice id.",
  "baseUrl": "https://oftendining.com/search.php",
  "$defs": {
    "storeSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "distanceMiles": {
          "type": "number"
        },
        "online": {
          "type": "boolean"
        },
        "pickup": {
          "type": "boolean"
        },
        "delivery": {
          "type": "boolean"
        },
        "pickupWaitMinutes": {
          "type": "number"
        },
        "deliveryWaitMinutes": {
          "type": "number"
        },
        "hours": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "days": {
                "type": "string"
              },
              "times": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "days",
              "times"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "phone",
        "address",
        "latitude",
        "longitude",
        "distanceMiles",
        "online",
        "pickup",
        "delivery",
        "pickupWaitMinutes",
        "deliveryWaitMinutes",
        "hours"
      ],
      "additionalProperties": false
    },
    "menuItem": {
      "type": "object",
      "properties": {
        "productId": {
          "type": "integer"
        },
        "sizeId": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "unavailable": {
          "type": "boolean"
        },
        "requiresModifiers": {
          "type": "boolean",
          "description": "Item needs modifier choices the quick-add flow cannot make; add it in the restaurant page instead"
        },
        "hasMoreSizes": {
          "type": "boolean"
        },
        "imageUrl": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "productId",
        "sizeId",
        "name",
        "description",
        "price",
        "unavailable",
        "requiresModifiers",
        "hasMoreSizes",
        "imageUrl"
      ],
      "additionalProperties": false
    },
    "charge": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "amount": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "amount"
      ],
      "additionalProperties": false
    }
  },
  "actions": [
    {
      "id": "getSignInUrl",
      "label": "Sign in to Often Dining",
      "description": "Opens Often Dining for sign-in.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getSignInState",
      "label": "Check sign-in",
      "description": "Whether the user is signed in.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "signedIn": {
            "type": "boolean"
          }
        },
        "required": [
          "signedIn"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getProfile",
      "label": "Account profile",
      "description": "Reads the signed-in user's name, phone number, and saved curbside pickup vehicle.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "vehicle": {
            "type": "object",
            "properties": {
              "make": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "licensePlate": {
                "type": "string"
              }
            },
            "required": [
              "make",
              "model",
              "color",
              "licensePlate"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "firstName",
          "lastName",
          "phone",
          "vehicle"
        ],
        "additionalProperties": false
      },
      "defaultArgs": {},
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "listOrders",
      "label": "Order history",
      "description": "Lists past orders with their restaurant, date, status, total, and receipt id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "Opaque cursor from a previous page"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Receipt id for getOrder"
                },
                "storeId": {
                  "type": "string"
                },
                "typeId": {
                  "type": "integer",
                  "description": "Order type used by the restaurant"
                },
                "orderedOn": {
                  "type": "string"
                },
                "restaurant": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "total": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "storeId",
                "typeId",
                "orderedOn",
                "restaurant",
                "status",
                "total"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": true
    },
    {
      "id": "searchStores",
      "label": "Search restaurants",
      "description": "Finds nearby restaurants, with each location's address, distance, pickup and delivery options, wait times, and opening hours. Defaults to Seattle.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Optional name or cuisine keyword"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "openNow": {
            "type": "boolean",
            "default": false
          },
          "cursor": {
            "type": "string",
            "description": "Opaque cursor from a previous page"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/storeSummary"
            }
          },
          "nextCursor": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getMenu",
      "label": "Restaurant menu",
      "description": "Shows a restaurant's menu by category, including prices, descriptions, availability, and which items need choices before they can be added.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "storeId": {
            "type": "string",
            "minLength": 1,
            "description": "Store id from searchStores"
          },
          "typeId": {
            "type": "integer",
            "default": 101,
            "description": "Order type: 101 pickup, 100 delivery"
          }
        },
        "required": [
          "storeId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/menuItem"
                  }
                }
              },
              "required": [
                "name",
                "items"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "categories"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "updateCart",
      "label": "Fill cart",
      "description": "Fills one restaurant's cart with the selected items and calculates the price. You review and pay on the restaurant's checkout page; this action never places the order. Items that need extra choices cannot be added here.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "storeId": {
            "type": "string",
            "minLength": 1,
            "description": "Store id from searchStores"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "integer",
                  "description": "Product id from getMenu"
                },
                "sizeId": {
                  "type": "integer",
                  "default": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Item name from getMenu"
                },
                "quantity": {
                  "type": "number",
                  "default": 1
                },
                "notes": {
                  "type": "string",
                  "description": "Item-level special instructions"
                }
              },
              "required": [
                "productId",
                "name"
              ],
              "additionalProperties": false
            }
          },
          "typeId": {
            "type": "integer",
            "default": 101,
            "description": "Order type: 101 pickup, 100 delivery"
          },
          "notes": {
            "type": "string",
            "description": "Order-level special instructions"
          }
        },
        "required": [
          "storeId",
          "items"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unitPrice": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              },
              "required": [
                "name",
                "quantity",
                "unitPrice",
                "total"
              ],
              "additionalProperties": false
            }
          },
          "subtotal": {
            "type": "number"
          },
          "taxes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/charge"
            }
          },
          "fees": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/charge"
            }
          },
          "total": {
            "type": "number"
          },
          "readyAt": {
            "type": "string",
            "description": "Estimated ready time, local to the restaurant"
          }
        },
        "required": [
          "items",
          "subtotal",
          "taxes",
          "fees",
          "total",
          "readyAt"
        ],
        "additionalProperties": false
      },
      "requireApproval": true,
      "requireAuth": false,
      "baseUrl": "https://oftendining.com/"
    },
    {
      "id": "getPaymentUrl",
      "label": "Checkout page",
      "description": "Opens the restaurant's checkout page for the prepared cart, where you can review and pay.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "storeId": {
            "type": "string",
            "minLength": 1,
            "description": "Store id whose cart to review"
          },
          "typeId": {
            "type": "integer",
            "default": 101,
            "description": "Order type: 101 pickup, 100 delivery"
          }
        },
        "required": [
          "storeId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false
    },
    {
      "id": "getPaymentState",
      "label": "Checkout state",
      "description": "Checks whether the restaurant cart is awaiting review, has been completed, or no longer exists. A declined payment remains awaiting review so the user can correct it on the checkout page. A completed order includes its invoice number.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "storeId": {
            "type": "string",
            "minLength": 1,
            "description": "Store id whose cart to probe"
          },
          "typeId": {
            "type": "integer",
            "default": 101,
            "description": "Order type: 101 pickup, 100 delivery"
          },
          "since": {
            "type": "string",
            "description": "Episode start, YYYY-MM-DD HH:MM:SS local; scopes completion reconstruction"
          }
        },
        "required": [
          "storeId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "none",
              "pending",
              "completed"
            ]
          },
          "reference": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "expiresAt": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "completedAt": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "reference",
          "total",
          "expiresAt",
          "completedAt"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": false,
      "baseUrl": "https://oftendining.com/"
    },
    {
      "id": "getOrder",
      "label": "Order receipt",
      "description": "Read an order's receipt by invoice id: status, pickup time, items, totals, and the (masked) payment used.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Invoice id from the completed checkout state"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "pickupTime": {
            "type": "string"
          },
          "orderedOn": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quantity": {
                  "type": "number"
                },
                "name": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                }
              },
              "required": [
                "quantity",
                "name",
                "price"
              ],
              "additionalProperties": false
            }
          },
          "subtotal": {
            "type": "number"
          },
          "taxes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/charge"
            }
          },
          "fees": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/charge"
            }
          },
          "total": {
            "type": "number"
          },
          "payment": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "orderId",
          "status",
          "pickupTime",
          "orderedOn",
          "items",
          "subtotal",
          "taxes",
          "fees",
          "total",
          "payment"
        ],
        "additionalProperties": false
      },
      "requireApproval": false,
      "requireAuth": true
    }
  ],
  "locales": {
    "zh-Hans": {
      "name": "Often Dining",
      "description": "本地餐厅在线点餐平台。按位置搜索附近餐厅，浏览餐厅菜单（含价格和图片），并生成已计价的自取购物车；用户在餐厅自己的结账页确认并付款，之后可按发票 id 查看收据。",
      "actions": {
        "getSignInUrl": {
          "label": "登录 Often Dining",
          "description": "打开 Often Dining 登录页。"
        },
        "getSignInState": {
          "label": "检查 Often Dining 登录状态",
          "description": "检查你是否已登录 Often Dining。"
        },
        "getProfile": {
          "label": "账户资料",
          "description": "读取已登录用户的姓名、电话号码和保存的路边取餐车辆信息。"
        },
        "listOrders": {
          "label": "订单记录",
          "description": "列出历史订单的餐厅、日期、状态、总额和收据 id。"
        },
        "searchStores": {
          "label": "搜索餐厅",
          "description": "查找附近餐厅，并显示地址、距离、自取和外送选项、等待时间及营业时间。默认地点为西雅图。"
        },
        "getMenu": {
          "label": "餐厅菜单",
          "description": "按分类显示餐厅菜单，包括价格、描述、供应状态，以及哪些商品需要先选择选项才能加入购物车。"
        },
        "updateCart": {
          "label": "填充购物车",
          "description": "用所选商品填充一家餐厅的购物车并计算价格。你需要在餐厅的结账页确认并付款；此操作不会直接下单。需要额外选择的商品无法在此加入。"
        },
        "getPaymentUrl": {
          "label": "结账页",
          "description": "打开已准备购物车的餐厅结账页，你可以在那里确认并付款。"
        },
        "getPaymentState": {
          "label": "结账状态",
          "description": "检查餐厅购物车是待确认、已完成还是已不存在。付款被拒后仍会显示为待确认，用户可在结账页更正。已完成的订单会显示发票号。"
        },
        "getOrder": {
          "label": "订单收据",
          "description": "按发票 id 读取订单收据：状态、取餐时间、商品、金额明细，以及（已脱敏的）支付方式。"
        }
      }
    }
  },
  "faviconUrl": "https://openox.ai/assets/services/oftendining.com/favicon.png"
}